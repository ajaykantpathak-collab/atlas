# ============================================================================
# Atlas platform — environment template.
#
# Copy to .env at the REPO ROOT and fill in real values:
#     copy .env.template .env
#
# backend/config.py reads pydantic-settings with env_prefix="PLATFORM_" and
# also loads this file directly (relative to the working directory). Other
# backend modules read the plain names below via os.environ / os.getenv.
# NO REAL SECRETS belong in this file or in git.
# ============================================================================

# ---------------------------- CORE APP --------------------------------------
# development | production | testing  (production enforces strong JWT secret)
PLATFORM_ENV=development
PLATFORM_DEBUG=false
# SQLite local mode (works out of the box); use PostgreSQL in production:
#   postgresql+asyncpg://user:password@localhost:5432/atlas
PLATFORM_DATABASE_URL=sqlite+aiosqlite:///./backend_local.db
# 64+ random chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
PLATFORM_JWT_SECRET=CHANGE_ME_random_64_char_secret
# Comma-separated origins allowed by CORS
PLATFORM_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PLATFORM_API_PREFIX=/api
PLATFORM_APP_VERSION=1.0.0
# Alternative env var names also honoured for the DB URL (dream_app compat):
# DATABASE_URL / POSTGRES_URL / PLATFORM_DATABASE_URL (first non-empty wins)
# DATABASE_URL=
# POSTGRES_URL=
# SQL echo + pool tuning (optional)
SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ---------------------------- SERVICES (all optional in SQLite mode) --------
REDIS_URL=redis://localhost:6379/0
REDIS_DEFAULT_TTL=3600
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME
# NEO4J_URL=bolt://localhost:7687   (config alias for NEO4J_URI)
NEO4J_DATABASE=neo4j
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=k12_knowledge
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

