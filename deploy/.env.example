# ============================================
# DREAM_APP Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# App
ENVIRONMENT=development
API_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL
POSTGRES_URL=postgresql+asyncpg://dream_user:dream_secure_2024@localhost:5432/dream_app

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<SET_VIA_ENVIRONMENT>

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_PASSWORD=<SET_VIA_ENVIRONMENT>

# AI Models (optional - only needed for AI features)
DEEPSEEK_API_KEY=<SET_VIA_ENVIRONMENT>
DEEPSEEK_BASE_URL=https://api.deepseek.com
EDUQWEN_API_KEY=<SET_VIA_ENVIRONMENT>
EDUQWEN_BASE_URL=https://api.qwen.ai/v1
GLM_API_KEY=<SET_VIA_ENVIRONMENT>
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Langfuse (optional - observability)
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=<SET_VIA_ENVIRONMENT>
LANGFUSE_SECRET_KEY=<SET_VIA_ENVIRONMENT>

# Auth
JWT_SECRET=<SET_VIA_ENVIRONMENT>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Payments (optional)
RAZORPAY_KEY_ID=<SET_VIA_ENVIRONMENT>
RAZORPAY_KEY_SECRET=<SET_VIA_ENVIRONMENT>

# Data Paths
KNOWLEDGE_DB_PATH=D:/KnowledgeBase/knowledge_nodes.db
VERIFIED_ANSWERS_PATH=
PARSED_CBSE_PATH=
PARSED_CISCE_PATH=
GRAPH_DATA_PATH=
NODE_GENERATOR_PATH=D:/node_generator

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
