# Copy to .env and fill in REAL values — never commit real credentials.
DATABASE_URL=postgresql+asyncpg://dream_user:YOUR_POSTGRES_PASSWORD@localhost:5432/dream_app
POSTGRES_URL=postgresql+asyncpg://dream_user:YOUR_POSTGRES_PASSWORD@localhost:5432/dream_app
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=dream_user
CLICKHOUSE_PASSWORD=YOUR_CLICKHOUSE_PASSWORD

# --- Payments (modules/payments) — ALL OPTIONAL until launch ---
# Unset = every money endpoint returns 503 "payments not configured" and
# /pricing shows the waitlist. Use Razorpay TEST keys first (rzp_test_...).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
