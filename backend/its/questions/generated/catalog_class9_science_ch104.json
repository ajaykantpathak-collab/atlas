  {
   "id": "iesc.104.1",
   "title": "Average Speed",
   "solution_type": "compute",
   "solution_steps": [
    {
     "step": 1,
     "name": "avg_speed",
     "expr": "total_distance / time_interval",
     "explain": "average speed is total path length over total time"
    },
    {
     "step": 2,
     "name": "half_speed",
     "expr": "avg_speed / 2",
     "explain": "speed if the time doubled"
    },
    {
     "step": 3,
     "name": "distance_km_per_min",
     "expr": "avg_speed / 60",
     "explain": "the same speed per minute"
    }
   ],
