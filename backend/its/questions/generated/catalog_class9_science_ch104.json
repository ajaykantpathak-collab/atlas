  {
   "id": "iesc.104.3",
   "title": "Average Acceleration",
   "solution_type": "compute",
   "solution_steps": [
    {
     "step": 1,
     "name": "velocity_change",
     "expr": "final_velocity - initial_velocity",
     "explain": "find the change in velocity"
    },
    {
     "step": 2,
     "name": "half_time_change",
     "expr": "velocity_change / 2",
     "explain": "velocity change in half the time"
    },
    {
     "step": 3,
     "name": "avg_acceleration",
     "expr": "velocity_change / time_interval",
     "explain": "divide the change by the time taken"
    }
   ],
