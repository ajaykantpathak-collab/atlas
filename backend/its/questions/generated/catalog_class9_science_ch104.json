  {
   "id": "iesc.104.6",
   "title": "Kinematic Equation: Velocity-Displacement",
   "solution_type": "compute",
   "solution_steps": [
    {
     "step": 1,
     "name": "u_squared",
     "expr": "initial_velocity ** 2",
     "explain": "square the starting velocity"
    },
    {
     "step": 2,
     "name": "v_squared",
     "expr": "u_squared + 2 * acceleration * displacement",
     "explain": "v squared = u squared + 2as"
    },
    {
     "step": 3,
     "name": "half_distance_v",
     "expr": "sqrt(u_squared + 2 * acceleration * (displacement / 2))",
     "explain": "speed gained over half the distance"
    },
    {
     "step": 4,
     "name": "final_velocity",
     "expr": "sqrt(v_squared)",
     "explain": "take the square root for v"
    }
   ],
