  {
   "id": "iesc.104.5",
   "title": "Kinematic Equation: Displacement",
   "solution_type": "compute",
   "solution_steps": [
    {
     "step": 1,
     "name": "uniform_part",
     "expr": "initial_velocity * time",
     "explain": "distance at the starting speed"
    },
    {
     "step": 2,
     "name": "accelerated_part",
     "expr": "0.5 * acceleration * time ** 2",
     "explain": "extra distance from acceleration"
    },
    {
     "step": 3,
     "name": "double_time_s",
     "expr": "initial_velocity * (time * 2) + 0.5 * acceleration * (time * 2) ** 2",
     "explain": "displacement if the time doubled"
    },
    {
     "step": 4,
     "name": "displacement_s",
     "expr": "uniform_part + accelerated_part",
     "explain": "s = ut + (1/2)at squared"
    }
   ],
