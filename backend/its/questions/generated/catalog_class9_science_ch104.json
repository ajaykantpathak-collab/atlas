  {
   "id": "iesc.104.4",
   "title": "Kinematic Equation: Final Velocity",
   "solution_type": "compute",
   "solution_steps": [
    {
     "step": 1,
     "name": "velocity_gain",
     "expr": "acceleration * time",
     "explain": "the extra velocity gained while accelerating"
    },
    {
     "step": 2,
     "name": "gain_per_second",
     "expr": "velocity_gain / time",
     "explain": "velocity gained per second"
    },
    {
     "step": 3,
     "name": "final_velocity",
     "expr": "initial_velocity + velocity_gain",
     "explain": "v = u + at"
    }
   ],
