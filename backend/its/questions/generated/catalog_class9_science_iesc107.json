   "title": "Work Done by a Force",
   "solution_type": "compute",
   "solution_steps": [
    {
     "step": 1,
     "name": "work",
     "expr": "force * distance",
     "explain": "W = F x s"
    },
    {
     "step": 2,
     "name": "half_distance_work",
     "expr": "force * (distance / 2)",
     "explain": "work over half the distance"
    },
    {
     "step": 3,
     "name": "work_kj",
     "expr": "work / 1000",
     "explain": "convert to kilojoules"
    }
   ],
