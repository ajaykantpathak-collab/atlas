  {
   "id": "iesc.107.7.2",
   "title": "Kinetic and Potential Energy",
   "solution_type": "compute",
   "solution_steps": [
    {
     "step": 1,
     "name": "velocity_squared",
     "expr": "velocity ** 2",
     "explain": "square the speed"
    },
    {
     "step": 2,
     "name": "ke_half_speed",
     "expr": "mass * (velocity / 2) ** 2 / 2",
     "explain": "kinetic energy at half the speed"
    },
    {
     "step": 3,
     "name": "kinetic",
     "expr": "mass * velocity_squared / 2",
     "explain": "KE = mv squared / 2"
    }
   ],
   "questions": [
    {
     "q": "A 4 kg body moves at 5 m/s. Find its kinetic energy.",
     "vals": {
