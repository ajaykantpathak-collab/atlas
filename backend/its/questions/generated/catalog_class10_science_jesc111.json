   "id": "jesc.111.11.4",
   "title": "Heating Effect and Electric Power",
   "solution_type": "compute",
   "solution_steps": [
    {
     "step": 1,
     "name": "current_ma",
     "expr": "current * 1000",
     "explain": "current in milliamperes"
    },
    {
     "step": 2,
     "name": "voltage_kv",
     "expr": "potential / 1000",
     "explain": "voltage in kilovolts"
    },
    {
     "step": 3,
     "name": "power",
     "expr": "potential * current",
     "explain": "P = V x I"
    }
