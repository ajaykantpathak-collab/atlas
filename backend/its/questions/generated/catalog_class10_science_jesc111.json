  {
   "id": "jesc.111.11.2",
   "title": "Ohm's Law - Current, Voltage and Resistance",
   "solution_type": "compute",
   "solution_steps": [
    {
     "step": 1,
     "name": "half_resistance",
     "expr": "resistance / 2",
     "explain": "resistance of a thinner wire"
    },
    {
     "step": 2,
     "name": "half_r_voltage",
     "expr": "current * half_resistance",
     "explain": "voltage across it"
    },
    {
     "step": 3,
     "name": "potential",
     "expr": "current * resistance",
     "explain": "V = IR"
    }
   ],
