   "id": "jesc.111.11.1",
   "title": "Electric Current and Potential Difference",
   "solution_type": "compute",
   "solution_steps": [
    {
     "step": 1,
     "name": "time_in_minutes",
     "expr": "time / 60",
     "explain": "the same time in minutes"
    },
    {
     "step": 2,
     "name": "charge_per_minute",
     "expr": "charge / time_in_minutes",
     "explain": "charge shifted per minute"
    },
    {
     "step": 3,
     "name": "current",
     "expr": "charge / time",
     "explain": "I = Q/t"
    }
   ],
