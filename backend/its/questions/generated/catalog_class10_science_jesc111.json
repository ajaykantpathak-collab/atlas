  {
   "id": "jesc.111.11.3",
   "title": "Series and Parallel Circuits",
   "solution_type": "compute",
   "solution_steps": [
    {
     "step": 1,
     "name": "mean_resistance",
     "expr": "(r1 + r2) / 2",
     "explain": "average of the two resistors"
    },
    {
     "step": 2,
     "name": "r1_doubled",
     "expr": "r1 * 2",
     "explain": "total if both were like the first"
    },
    {
     "step": 3,
     "name": "series_res",
     "expr": "r1 + r2",
     "explain": "series resistances add"
    }
   ],
