 "slides": [
  {
   "title": "Coins AND Notes 🪙💵",
   "text": "We use coins AND notes! Coins are ₹1, ₹2, ₹5 and ₹10. Notes are ₹10, ₹20, ₹50 and ₹100. Both are rupees — add them together to know how much money you have!",
   "emoji": "🪙",
   "bgColor": "from-amber-400 to-orange-500",
   "spoken": "Coins and notes are both rupees. We can add them together.",
   "diagram": {
    "type": "generic-flow",
    "animate": true,
    "title": "Our money",
    "data": {
     "steps": [
      "Coins: ₹1 ₹2 ₹5",
      "Notes: ₹10 ₹20 ₹50 ₹100",
      "Add them all!"
     ]
    }
   }
  },
  {
   "title": "Notes Carry Bigger Values 💵",
   "text": "One ₹50 note is worth the SAME as fifty ₹1 coins — but it is much easier to carry! That is why we use notes for bigger amounts.",
   "emoji": "💵",
   "bgColor": "from-emerald-400 to-teal-500",
   "spoken": "A fifty-rupee note equals fifty one-rupee coins.",
   "diagram": {
    "type": "generic-flow",
    "animate": true,
    "title": "Same value!",
    "data": {
     "steps": [
      "₹50 note",
      "=",
      "50 one-rupee coins"
     ]
    }
   }
  },
  {
   "title": "Add Coins to Find the Total 🧮",
   "text": "Add each coin as you count! ₹5 and ₹5 and ₹2: five plus five is ten, ten plus two is twelve. The total is ₹12!",
   "emoji": "🧮",
   "bgColor": "from-blue-400 to-indigo-500",
   "spoken": "Add coin after coin to find the total money.",
   "diagram": {
    "type": "generic-flow",
    "animate": true,
    "title": "Adding coins",
    "data": {
     "steps": [
      "₹5 + ₹5 = ₹10",
      "₹10 + ₹2",
      "= ₹12"
     ]
    }
   }
  },
  {
   "title": "Add a Note and a Coin 🧾",
   "text": "Notes and coins add together too! A ₹20 note and a ₹5 coin: 20 plus 5 makes 25. You have ₹25. Always add the note first, then add each coin.",
   "emoji": "🧾",
   "bgColor": "from-purple-400 to-pink-500",
   "spoken": "Add the note first, then add the coins.",
   "diagram": {
    "type": "generic-flow",
    "animate": true,
    "title": "Note plus coin",
    "data": {
     "steps": [
      "₹20 note",
      "+ ₹5 coin",
      "= ₹25"
     ]
    }
   }
  },
  {
   "title": "Many Ways to Make an Amount 💡",
   "text": "The same amount can be made in different ways! ₹20 can be ONE ₹20 note, or TWO ₹10 notes, or even ₹10 + ₹5 + ₹5. Different coins and notes, same total!",
   "emoji": "💡",
   "bgColor": "from-rose-400 to-red-500",
   "spoken": "The same amount of money can be made in many ways.",
   "diagram": {
    "type": "generic-flow",
    "animate": true,
    "title": "Make ₹20",
    "data": {
     "steps": [
      "One ₹20 note",
      "Two ₹10 notes",
      "All make ₹20!"
     ]
    }
   }
  }
 ],
