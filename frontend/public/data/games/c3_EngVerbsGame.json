 "slides": [
  {
   "title": "What is a Verb? 🏃",
   "text": "A verb is an ACTION word — run, eat, jump, sleep! It tells what someone or something DOES!",
   "emoji": "🏃",
   "bgColor": "from-red-400 to-orange-500",
   "spoken": ""
  },
  {
   "title": "Action You See 👀",
   "text": "'The bird flies.' 'The baby cries.' — the action word is the verb. Ask: what is happening?",
   "emoji": "👀",
   "bgColor": "from-blue-400 to-indigo-500",
   "spoken": ""
  },
  {
   "title": "Being Verbs 🤫",
   "text": "'is', 'am', 'are' are quiet verbs — no action, but they link words: 'She is happy'!",
   "emoji": "🤫",
   "bgColor": "from-green-400 to-emerald-500",
   "spoken": ""
  },
  {
   "title": "Past & Present Verbs ⏳",
   "text": "'I play' (now) → 'I played' (before). Verbs change with time — the -ed ending marks done!",
   "emoji": "⏳",
   "bgColor": "from-purple-400 to-violet-500",
   "spoken": ""
  },
  {
   "title": "Verb in Every Sentence ⚙️",
   "text": "Every sentence needs a verb — it is the engine! 'The boy ran' — 'ran' powers the sentence!",
   "emoji": "⚙️",
   "bgColor": "from-pink-400 to-rose-500",
   "spoken": ""
  }
 ],
