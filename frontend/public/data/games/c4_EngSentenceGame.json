 "slides": [
  {
   "title": "Sentence Structure 🏗️",
   "text": "A sentence = Subject + Verb + Object: 'The boy (S) kicked (V) the ball (O).' Order carries meaning!",
   "emoji": "🏗️",
   "bgColor": "from-blue-400 to-indigo-500",
   "spoken": ""
  },
  {
   "title": "Statement vs Question vs Command 🎭",
   "text": "'You are late.' (statement) 'Are you late?' (question) 'Sit down!' (command) — same idea, different form!",
   "emoji": "🎭",
   "bgColor": "from-purple-400 to-violet-500",
   "spoken": ""
  },
  {
   "title": "The Question Flip 🔄",
   "text": "Questions flip the helper verb to the front: 'You are late' → 'Are you late?' — word order changes the type!",
   "emoji": "🔄",
   "bgColor": "from-green-400 to-emerald-500",
   "spoken": ""
  },
  {
   "title": "Punctuation Tells the Type ❗",
   "text": ". = statement, ? = question, ! = command/feeling — the mark is the sentence's mood!",
   "emoji": "❗",
   "bgColor": "from-orange-400 to-amber-500",
   "spoken": ""
  },
  {
   "title": "Expanded Sentences 🌳",
   "text": "'The dog ran.' → 'The big black dog ran quickly home.' — adjectives and adverbs grow the sentence!",
   "emoji": "🌳",
   "bgColor": "from-pink-400 to-rose-500",
   "spoken": ""
  }
 ],
