          "steps": [
            "Input",
            "Process",
            "Output",
            "Store"
          ]
        }
      }
    },
    {
      "title": "Types of Computers 📱",
      "text": "Computers come in many shapes and sizes! We have big desktop computers on desks, portable laptops, handheld tablets, and pocket-sized smartphones!",
      "emoji": "📱",
      "bgColor": "from-indigo-500 to-purple-600",
      "spoken": "Computers come in many shapes and sizes! Desktops, laptops, tablets, and smartphones!",
      "diagram": {
