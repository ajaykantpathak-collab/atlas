        "data": {
          "steps": [
            "Input",
            "Process",
            "Output",
            "Store"
          ]
        }
      }
    },
    {
      "title": "What Do We Use Computers For? 🎨",
      "text": "We use computers for so many fun and useful things! We can draw pictures, learn math, write stories, play educational games, and watch educational videos!",
      "emoji": "🎨",
      "bgColor": "from-teal-500 to-cyan-600",
      "spoken": "We use computers to draw pictures, learn math, write stories, play games, and watch videos!",
      "diagram": {
