  {
   "title": "What is a Riddle? 🧩",
   "text": "A riddle hides a number in clues! 'I am bigger than 5, smaller than 7' — I'm 6!",
   "emoji": "🧩",
   "bgColor": "from-purple-400 to-violet-500",
   "spoken": ""
  },
  {
   "title": "Clue by Clue 🔍",
   "text": "Each clue cuts down the possibilities. Keep only numbers that satisfy EVERY clue!",
   "emoji": "🔍",
   "bgColor": "from-blue-400 to-indigo-500",
   "spoken": ""
  },
  {
   "title": "Even and Odd 🎭",
   "text": "Even numbers pair up perfectly: 2, 4, 6, 8... Odd ones always leave one lonely: 3, 5, 7...",
   "emoji": "🎭",
   "bgColor": "from-green-400 to-emerald-500",
   "spoken": ""
  },
  {
   "title": "Before, After, Between ↔️",
   "text": "'I come right after 11' → 12. 'I'm between 8 and 10' → 9. Neighbour clues are easy!",
   "emoji": "↔️",
   "bgColor": "from-orange-400 to-red-500",
   "spoken": ""
  },
  {
   "title": "Shape Riddles Too! 🔺",
   "text": "'I have 3 sides and 3 corners' — triangle! Riddles work for shapes, not just numbers!",
   "emoji": "🔺",
   "bgColor": "from-pink-400 to-rose-500",
   "spoken": ""
  }
 ],
