 "slides": [
  {
   "title": "What is a Matra? 🪔",
   "text": "Matras are marks that stick to letters to change their vowel sound! क + ा = का (kaa)!",
   "emoji": "🪔",
   "bgColor": "from-red-400 to-rose-500",
   "spoken": ""
  },
  {
   "title": "The 'aa' Matra ा",
   "text": "A vertical line after the letter makes 'aa' — म + ा = मा (maa, mother)!",
   "emoji": "ा",
   "bgColor": "from-pink-400 to-rose-500",
   "spoken": ""
  },
  {
   "title": "The 'ee' Matras ी and ि",
   "text": "ी after a letter makes 'ee' — ब + ी = बी. ि before makes 'i' — क + ि = कि!",
   "emoji": "ी",
   "bgColor": "from-blue-400 to-indigo-500",
   "spoken": ""
  },
  {
   "title": "The 'oo' Matras ू and ु",
   "text": "ू below makes 'oo' (long) — स + ू = सू. ु makes 'u' (short) — क + ु = कु!",
   "emoji": "ू",
   "bgColor": "from-green-400 to-emerald-500",
   "spoken": ""
  },
  {
   "title": "Read with Matras! 📖",
   "text": "Now you can read words! मा, पी, सू, कु — every matra changes the vowel inside the word!",
   "emoji": "📖",
   "bgColor": "from-purple-400 to-violet-500",
   "spoken": ""
  }
 ],
