 "slides": [
  {
   "title": "What is a Sentence? ✏️",
   "text": "A sentence is a group of words that tells a complete idea: 'The cat sits.' — complete thought!",
   "emoji": "✏️",
   "bgColor": "from-blue-400 to-indigo-500",
   "spoken": ""
  },
  {
   "title": "Every Sentence Has a WHO 👤",
   "text": "Who or what is the sentence about? 'The cat' — that's the WHO part!",
   "emoji": "👤",
   "bgColor": "from-pink-400 to-rose-500",
   "spoken": ""
  },
  {
   "title": "Every Sentence Has a DOING 🏃",
   "text": "What does the WHO do? 'sits' — the DOING part! Who + Doing = sentence!",
   "emoji": "🏃",
   "bgColor": "from-green-400 to-emerald-500",
   "spoken": ""
  },
  {
   "title": "Big Letter, Full Stop 🔴",
   "text": "Sentences start with a BIG letter and end with a dot: 'The dog runs.' — capital + period!",
   "emoji": "🔴",
   "bgColor": "from-orange-400 to-amber-500",
   "spoken": ""
  },
  {
   "title": "Build a Sentence! 🏗️",
   "text": "Take a WHO + a DOING: 'The bird' + 'sings' = 'The bird sings.' — you built a sentence!",
   "emoji": "🏗️",
   "bgColor": "from-purple-400 to-violet-500",
   "spoken": ""
  }
 ],
