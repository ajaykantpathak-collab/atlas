 "slides": [
  {
   "title": "The Shopping Bill 🧾",
   "text": "A bill lists what you bought and each price. To check a bill, ADD all the prices. Rice ₹45, dal ₹30, oil ₹25: 45 + 30 = 75, and 75 + 25 = 100. The bill is ₹100!",
   "emoji": "🧾",
   "bgColor": "from-amber-400 to-orange-500",
   "spoken": "Add all the prices on a bill to find the total.",
   "diagram": {
    "type": "generic-flow",
    "animate": true,
    "title": "Adding a bill",
    "data": {
     "steps": [
      "₹45 + ₹30 = ₹75",
      "₹75 + ₹25",
      "= ₹100"
     ]
    }
   }
  },
  {
   "title": "Adding Money by Place Value 🧮",
   "text": "Add money like numbers! ₹25 + ₹35: ones first, 5 + 5 = 10, carry the ten; tens next, 2 + 3 = 5, plus the carried ten makes 6. Total ₹60!",
   "emoji": "🧮",
   "bgColor": "from-blue-400 to-indigo-500",
   "spoken": "Add rupees just like numbers, ones first then tens.",
   "diagram": {
    "type": "generic-flow",
    "animate": true,
    "title": "Column addition",
    "data": {
     "steps": [
      "Ones: 5 + 5 = 10",
      "Carry the ten",
      "Tens: 2 + 3 + 1 = 6 → ₹60"
     ]
    }
   }
  },
  {
   "title": "Change = Paid − Price 🔁",
   "text": "Change is what you get back. Change = money paid − price. A dress costs ₹180 and you pay ₹200: 200 − 180 = 20, so the change is ₹20.",
   "emoji": "🔁",
   "bgColor": "from-emerald-400 to-teal-500",
   "spoken": "Subtract the price from the money paid to get the change.",
   "diagram": {
    "type": "generic-flow",
    "animate": true,
    "title": "Finding change",
    "data": {
     "steps": [
      "Paid ₹200",
      "− Price ₹180",
      "Change ₹20"
     ]
    }
   }
  },
  {
   "title": "Two-Step Shopping 🛍️",
   "text": "Some problems need TWO steps! First add what you bought, then subtract from what you paid. Shoes ₹250 + socks ₹40 = ₹290. Paid ₹500: 500 − 290 = ₹210 change!",
   "emoji": "🛍️",
   "bgColor": "from-purple-400 to-pink-500",
   "spoken": "First add the items, then subtract from the money paid.",
   "diagram": {
    "type": "generic-flow",
    "animate": true,
    "title": "Two steps",
    "data": {
     "steps": [
      "₹250 + ₹40 = ₹290",
      "₹500 − ₹290",
      "= ₹210 change"
     ]
    }
   }
  },
  {
   "title": "Check the Bill! ✅",
   "text": "Smart shoppers ALWAYS check: add the items again — does it match the total? ₹65 + ₹45: 5 + 5 = 10, 6 + 4 = 10, carry... ₹110. If the bill says ₹120, say 'please check!'",
   "emoji": "✅",
   "bgColor": "from-rose-400 to-red-500",
   "spoken": "Add the prices again to check the bill's total.",
   "diagram": {
    "type": "generic-flow",
    "animate": true,
    "title": "Checking",
    "data": {
     "steps": [
      "₹65 + ₹45",
      "Ones 10, tens 10+1",
      "= ₹110 ✅"
     ]
    }
   }
  }
 ],
