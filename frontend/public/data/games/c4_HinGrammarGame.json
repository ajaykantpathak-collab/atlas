  {
   "title": "संज्ञा — Naming Words 🏷️",
   "text": "संज्ञा names a person, place, thing, feeling: 'राम', 'दिल्ली', 'पुस्तक', 'खुशी' — all संज्ञा!",
   "emoji": "🏷️",
   "bgColor": "from-blue-400 to-indigo-500",
   "spoken": ""
  },
  {
   "title": "सर्वनाम — Pronouns 🔄",
   "text": "सर्वनाम replaces the name: 'वह', 'मैं', 'तुम', 'यह' — stand-ins for संज्ञा!",
   "emoji": "🔄",
   "bgColor": "from-green-400 to-emerald-500",
   "spoken": ""
  },
  {
   "title": "विशेषण — Describing Words 🎨",
   "text": "विशेषण describes: 'बड़ा घर', 'सुंदर फूल', 'मीठा आम' — tells us MORE about the noun!",
   "emoji": "🎨",
   "bgColor": "from-purple-400 to-violet-500",
   "spoken": ""
  },
  {
   "title": "क्रिया — Action Words 🏃",
   "text": "क्रिया is the doing word: 'दौड़ना', 'पढ़ना', 'हँसना' — every sentence needs one!",
   "emoji": "🏃",
   "bgColor": "from-orange-400 to-amber-500",
   "spoken": ""
  },
  {
   "title": "Sort Them All! 🧺",
   "text": "नाम, शब्द-प्रकार — each word has a job. संज्ञा names, सर्वनाम substitutes, विशेषण describes, क्रिया acts!",
   "emoji": "🧺",
   "bgColor": "from-pink-400 to-rose-500",
   "spoken": ""
  }
 ],
