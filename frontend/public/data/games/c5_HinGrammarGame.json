 "slides": [
  {
   "title": "लिंग — Gender 📚",
   "text": "Hindi nouns have gender! 'लड़का' is masculine (पुल्लिंग), 'लड़की' is feminine (स्त्रीलिंग) — even for objects!",
   "emoji": "📚",
   "bgColor": "from-blue-400 to-indigo-500",
   "spoken": ""
  },
  {
   "title": "Adjective Changes Shape 🎨",
   "text": "'अच्छा लड़का' but 'अच्छी लड़की' — the adjective matches the noun's gender!",
   "emoji": "🎨",
   "bgColor": "from-purple-400 to-violet-500",
   "spoken": ""
  },
  {
   "title": "Verb Agrees Too 🔄",
   "text": "'राम खेलता है' but 'सीता खेलती है' — ता vs ती shows who the verb serves!",
   "emoji": "🔄",
   "bgColor": "from-green-400 to-emerald-500",
   "spoken": ""
  },
  {
   "title": "Common Patterns 🧩",
   "text": "Nouns ending in ा (लड़का, घोड़ा) are usually masculine; ending in ी (लड़की, रानी) usually feminine — a helpful rule!",
   "emoji": "🧩",
   "bgColor": "from-orange-400 to-amber-500",
   "spoken": ""
  },
  {
   "title": "Read for Agreement ✅",
   "text": "'बड़ी किताब पड़ी है' — बड़ी (fem adj) + किताब (fem noun) + पड़ी (fem verb) — everything agrees!",
   "emoji": "✅",
   "bgColor": "from-pink-400 to-rose-500",
   "spoken": ""
  }
 ],
