 "mascot": "Volume Vikram — a curious young engineer with a hard hat, a measuring jug and a box of unit cubes",
 "slideCount": 5,
 "challengeCount": 8,
 "slides": [
  {
   "title": "Space Inside = Volume 📦",
   "text": "Every box has space inside — that space is called VOLUME! A small box holds few cubes; a big box holds many. 'How big? How heavy?' is all about the space inside things!",
   "emoji": "📦",
   "bgColor": "from-blue-400 to-indigo-500",
   "spoken": "Volume is the space inside a container.",
   "diagram": {
    "type": "generic-flow",
    "animate": true,
    "title": "Space inside",
    "data": {
     "steps": [
      "Small box",
      "Big box",
      "More space = more cubes!"
     ]
    }
   }
  },
  {
   "title": "Count the Cubes 🧊",
   "text": "To find volume, fill the box with unit cubes and COUNT! A box with 3 cubes in a row and 2 rows holds 3 × 2 = 6 cubes. Its volume is 6 cubes!",
   "emoji": "🧊",
   "bgColor": "from-emerald-400 to-teal-500",
   "spoken": "Fill with unit cubes, then count them to find volume.",
   "diagram": {
    "type": "generic-flow",
    "animate": true,
    "title": "Counting volume",
    "data": {
     "steps": [
      "3 cubes in a row",
      "2 such rows",
      "3 × 2 = 6 cubes"
     ]
    }
   }
  },
  {
   "title": "Capacity: Hold the Liquid 🥛",
   "text": "How much liquid a container can hold is its CAPACITY! A spoon holds little; a bucket holds a lot. We measure liquid in litres (L) and millilitres (mL).",
   "emoji": "🥛",
   "bgColor": "from-amber-400 to-orange-500",
   "spoken": "Capacity is how much liquid a container holds — measured in litres and millilitres.",
   "diagram": {
    "type": "bar-chart",
    "animate": true,
    "title": "Who holds the most?",
    "data": {
     "bars": [
      {
       "label": "Spoon",
       "value": 1
      },
      {
       "label": "Bottle",
       "value": 4
      },
      {
       "label": "Bucket",
       "value": 9
      }
     ]
    }
   }
  },
  {
   "title": "Litres and Millilitres 🧴",
   "text": "1 litre = 1000 millilitres! Little amounts like medicine use mL: a teaspoon is about 5 mL. Big amounts use litres: a big water bottle holds 1 L.",
   "emoji": "🧴",
   "bgColor": "from-purple-400 to-pink-500",
   "spoken": "One litre is the same as one thousand millilitres.",
   "diagram": {
    "type": "generic-flow",
    "animate": true,
    "title": "L and mL",
    "data": {
     "steps": [
      "1 teaspoon ≈ 5 mL",
      "Big bottle = 1 L",
      "1 L = 1000 mL"
     ]
    }
   }
  },
  {
   "title": "Compare and Estimate 🎯",
   "text": "Estimate before you measure! Which holds more — a cup or a bucket? The bucket, of course! More cubes = bigger volume; more litres = bigger capacity.",
   "emoji": "🎯",
   "bgColor": "from-rose-400 to-red-500",
   "spoken": "Estimate first: the bigger container holds more.",
   "diagram": {
    "type": "generic-flow",
    "animate": true,
    "title": "Estimate, then check",
    "data": {
     "steps": [
      "Guess first",
      "Then measure",
      "Check who holds more!"
     ]
    }
   }
  }
 ],
