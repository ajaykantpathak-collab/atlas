 "slides": [
  {
   "title": "वर्णमाला क्या है? 🅰️",
   "text": "Hindi has letters called 'akshar'! Each akshar has a sound — like 'क' says 'ka'. Together they make the varnamala!",
   "emoji": "🅰️",
   "bgColor": "from-orange-400 to-red-500",
   "spoken": ""
  },
  {
   "title": "स्वर — The Vowels ⭐",
   "text": "अ आ इ ई उ ऊ — these are swar (vowels)! They sing on their own and every word needs them!",
   "emoji": "⭐",
   "bgColor": "from-yellow-400 to-amber-500",
   "spoken": ""
  },
  {
   "title": "व्यंजन — The Consonants 🪁",
   "text": "क ख ग घ ङ — these are vyanjan! They need a swar to make a full sound, like क + अ = क!",
   "emoji": "🪁",
   "bgColor": "from-green-400 to-teal-500",
   "spoken": ""
  },
  {
   "title": "Same-Sound Families 👨‍👩‍👧",
   "text": "क-ख-ग-घ are neighbours in the varnamala — they are cousins in the same family!",
   "emoji": "👨‍👩‍👧",
   "bgColor": "from-blue-400 to-indigo-500",
   "spoken": ""
  },
  {
   "title": "Akshar to Word 📖",
   "text": "क + म + ल = कमल (kamal = lotus)! Put akshars together and magic happens — WORDS!",
   "emoji": "📖",
   "bgColor": "from-purple-400 to-pink-500",
   "spoken": ""
  }
 ],
