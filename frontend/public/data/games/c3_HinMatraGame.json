  {
   "title": "Beyond the Basics 🪔",
   "text": "You know ा ि ी ु ू — now meet े ै ो ौ ं! Five more matras to master!",
   "emoji": "🪔",
   "bgColor": "from-purple-400 to-violet-500",
   "spoken": ""
  },
  {
   "title": "े and ै — The 'e' Sounds",
   "text": "े makes 'e' (के = ke), ै makes 'ai' (कै = kai) — the double-stroke is deeper!",
   "emoji": "े",
   "bgColor": "from-blue-400 to-indigo-500",
   "spoken": ""
  },
  {
   "title": "ो and ौ — The 'o' Sounds",
   "text": "ो makes 'o' (को = ko), ौ makes 'au' (कौ = kau) — single vs double stroke again!",
   "emoji": "ो",
   "bgColor": "from-green-400 to-emerald-500",
   "spoken": ""
  },
  {
   "title": "ं — The Nasal Dot",
   "text": "ं adds a nasal 'n' sound: अंब, दंत, गंगा — the little dot hums!",
   "emoji": "ं",
   "bgColor": "from-orange-400 to-amber-500",
   "spoken": ""
  },
  {
   "title": "All Together Now 🎵",
   "text": "के कै को कौ कं — same letter क, five different sounds! Matras are the vowel toolbox!",
   "emoji": "🎵",
   "bgColor": "from-pink-400 to-rose-500",
   "spoken": ""
  }
