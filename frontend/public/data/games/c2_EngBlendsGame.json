 "slides": [
  {
   "title": "What is a Blend? 🌀",
   "text": "Two letters team up and BOTH keep their sounds! s + t = 'st' in 'stop'. Not a new sound — two sounds squeezed!",
   "emoji": "🌀",
   "bgColor": "from-purple-400 to-violet-500",
   "spoken": ""
  },
  {
   "title": "'Bl' and 'Br' 🔵",
   "text": "'bl' says 'buh-luh': blue, black, block! 'br' says 'buh-ruh': brown, bread, bring!",
   "emoji": "🔵",
   "bgColor": "from-blue-400 to-cyan-500",
   "spoken": ""
  },
  {
   "title": "'St' and 'Sp' 🌟",
   "text": "'st' in stop, star, stick. 'sp' in spin, spoon, spot. Hear both letters sing!",
   "emoji": "🌟",
   "bgColor": "from-green-400 to-teal-500",
   "spoken": ""
  },
  {
   "title": "'Tr' and 'Dr' 🚂",
   "text": "'tr' says 'tuh-ruh': tree, train, truck! 'dr' says 'duh-ruh': drum, draw, dress!",
   "emoji": "🚂",
   "bgColor": "from-orange-400 to-red-500",
   "spoken": ""
  },
  {
   "title": "Blend in the Middle & End 🎯",
   "text": "Blends can sit anywhere: 'jump' ends with 'mp', 'lamp' ends with 'mp' too!",
   "emoji": "🎯",
   "bgColor": "from-pink-400 to-rose-500",
   "spoken": ""
  }
 ],
