 "slides": [
  {
   "title": "What is Volume? 📦",
   "text": "Volume is how much SPACE something fills — a box's volume is how much fits inside it!",
   "emoji": "📦",
   "bgColor": "from-blue-400 to-cyan-500",
   "spoken": ""
  },
  {
   "title": "Counting Cubes 🧊",
   "text": "A cube is our volume unit! A box 3 long × 2 wide × 1 tall holds 3 × 2 × 1 = 6 cubes!",
   "emoji": "🧊",
   "bgColor": "from-green-400 to-teal-500",
   "spoken": ""
  },
  {
   "title": "Length × Width × Height ✖️",
   "text": "Volume = L × W × H! A 4 × 3 × 2 box holds 24 cubes — multiplication in three directions!",
   "emoji": "✖️",
   "bgColor": "from-purple-400 to-violet-500",
   "spoken": ""
  },
  {
   "title": "Litres & Millilitres 🥛",
   "text": "Liquids measure in litres! 1 litre = 1000 mL — a water bottle is about 1 litre, a spoon about 5 mL!",
   "emoji": "🥛",
   "bgColor": "from-orange-400 to-amber-500",
   "spoken": ""
  },
  {
   "title": "Big vs Small Containers ⚖️",
   "text": "A bucket holds ~20 litres, a cup ~200 mL — capacity is volume for containers!",
   "emoji": "⚖️",
   "bgColor": "from-pink-400 to-rose-500",
   "spoken": ""
  }
 ],
