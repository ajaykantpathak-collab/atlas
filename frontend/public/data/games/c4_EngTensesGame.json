 "slides": [
  {
   "title": "Three Times ⏰",
   "text": "English verbs travel through time: past (yesterday), present (now), future (tomorrow)!",
   "emoji": "⏰",
   "bgColor": "from-blue-400 to-indigo-500",
   "spoken": ""
  },
  {
   "title": "Past — Done! ✅",
   "text": "'I played.' 'She cooked.' Past tense is finished — look for -ed or special past words (went, ate)!",
   "emoji": "✅",
   "bgColor": "from-green-400 to-emerald-500",
   "spoken": ""
  },
  {
   "title": "Present — Now! ▶️",
   "text": "'I play.' 'She cooks.' Present is happening right now, or always true!",
   "emoji": "▶️",
   "bgColor": "from-orange-400 to-amber-500",
   "spoken": ""
  },
  {
   "title": "Future — Coming! 🔮",
   "text": "'I will play.' 'She will cook.' 'Will' is the future's ticket — it hasn't happened yet!",
   "emoji": "🔮",
   "bgColor": "from-purple-400 to-violet-500",
   "spoken": ""
  },
  {
   "title": "Listen for the Time Word 🗝️",
   "text": "'Yesterday' = past. 'Now/every day' = present. 'Tomorrow/next week' = future. The time word chooses the tense!",
   "emoji": "🗝️",
   "bgColor": "from-pink-400 to-rose-500",
   "spoken": ""
  }
 ],
