  "slides": [
    {
      "title": "Three Modes of Transport! 🚗",
      "text": "Transport means how we travel from one place to another. There are THREE modes: land, water, and air! A car runs on a road. A boat floats on water. An aeroplane flies in the sky!",
      "emoji": "🚗",
      "bgColor": "from-blue-400 to-indigo-500",
      "spoken": "Transport means how we travel. There are three modes: land, water, and air! A car runs on a road. A boat floats on water. An aeroplane flies in the sky!",
      "diagram": {
        "type": "water-cycle",
        "animate": true,
        "data": {}
      }
    },
    {
      "title": "Land Transport 🚗🚌🚲",
      "text": "Land transport moves on the ground — on roads, railway tracks, or paths! Cars, buses, trains, bicycles, motorcycles, and bullock carts are all land transport. They stay on a solid surface!",
      "emoji": "🚗",
      "bgColor": "from-amber-400 to-orange-500",
      "spoken": "Land transport moves on the ground on roads or tracks! Cars, buses, trains, and bicycles are all land transport. They stay on a solid surface!",
      "diagram": {
        "type": "generic-flow",
        "animate": true,
        "data": {
          "steps": [
            "Observe",
            "Experiment",
            "Conclude"
          ]
        }
      }
    },
    {
      "title": "Water Transport ⛵🚢",
      "text": "Water transport floats on water — rivers, lakes, ponds, and seas! Boats, ships, ferries, and rafts are water transport. A boat floats on water like a leaf floating on a puddle!",
      "emoji": "⛵",
      "bgColor": "from-cyan-400 to-blue-500",
      "spoken": "Water transport floats on water! Boats, ships, ferries, and rafts are water transport. A boat floats on water like a leaf floating on a puddle!",
      "diagram": {
        "type": "water-cycle",
        "animate": true,
        "data": {}
      }
    },
    {
      "title": "Air Transport ✈️🚁",
      "text": "Air transport flies through the sky! Aeroplanes, helicopters, gliders, and hot-air balloons are air transport. An aeroplane flies in the sky like a bird soaring through the air!",
      "emoji": "✈️",
      "bgColor": "from-sky-400 to-indigo-500",
      "spoken": "Air transport flies through the sky! Aeroplanes, helicopters, gliders, and hot-air balloons are air transport. An aeroplane flies like a bird soaring!",
      "diagram": {
        "type": "water-cycle",
        "animate": true,
        "data": {}
      }
    },
    {
      "title": "How They Move! 🛞🚣🪽",
      "text": "Land vehicles ROLL on wheels! Water vehicles FLOAT on water! Air vehicles FLY with wings! Remember: roll for land, float for water, fly for air! Three actions for three modes!",
      "emoji": "🛞",
      "bgColor": "from-emerald-400 to-teal-500",
      "spoken": "Land vehicles roll on wheels! Water vehicles float on water! Air vehicles fly with wings! Remember: roll for land, float for water, fly for air!",
