    },
    {
      "title": "Rainy Days and Clouds 🌧️",
      "text": "On a rainy day, thick clouds cover the Sun like a blanket over a lamp! They block the sunlight, so the day becomes cooler and darker!",
      "emoji": "🌧️",
      "bgColor": "from-cyan-500 to-blue-600",
