  {
   "title": "What is a Half? 🍕",
   "text": "Cut a pizza into 2 EQUAL pieces — each is one half (½)! Both pieces must be the same size!",
   "emoji": "🍕",
   "bgColor": "from-red-400 to-orange-500",
   "spoken": ""
  },
  {
   "title": "What is a Quarter? 🍰",
   "text": "Cut a cake into 4 EQUAL pieces — each is one quarter (¼)! Four equal parts!",
   "emoji": "🍰",
   "bgColor": "from-blue-400 to-indigo-500",
   "spoken": ""
  },
  {
   "title": "The Bottom Number Counts 🔢",
   "text": "½ = 1 out of 2 equal parts. ¼ = 1 out of 4. The bottom number says how many equal pieces!",
   "emoji": "🔢",
   "bgColor": "from-green-400 to-emerald-500",
   "spoken": ""
  },
  {
   "title": "Half of a Number ➗",
   "text": "Half of 8 is 4 — split 8 things into 2 equal groups! Half of 10 is 5!",
   "emoji": "➗",
   "bgColor": "from-purple-400 to-violet-500",
   "spoken": ""
  },
  {
   "title": "Equal Parts Only! ⚖️",
   "text": "A pizza cut into a big piece + small piece is NOT halves — halves must be EQUAL!",
   "emoji": "⚖️",
   "bgColor": "from-pink-400 to-rose-500",
   "spoken": ""
  }
 ],
