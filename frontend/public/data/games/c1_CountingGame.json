            "Ones"
          ],
          "digits": [
            "1",
            "2",
            "3",
            "4"
          ]
        }
      }
    },
    {
      "title": "Counting One by One 🖐️",
      "text": "When counting objects up to 20, touch each object exactly once and say the number names in order: one, two, three... up to twenty! Never skip or repeat a number!",
      "emoji": "🔢",
      "bgColor": "from-emerald-400 to-teal-500",
      "spoken": "",
      "diagram": {
        "type": "counting-objects",
        "animate": true,
        "data": {
          "count": 5,
          "shape": "star"
        }
      }
    },
    {
      "title": "The Teen Numbers 🌟",
      "text": "Numbers from 11 to 20 have two digits! 11 has a 1 in the tens place and a 1 in the units place. They go: eleven, twelve, thirteen, fourteen, fifteen, sixteen, seventeen, eighteen, nineteen, twenty!",
      "emoji": "✨",
      "bgColor": "from-amber-400 to-orange-500",
      "spoken": "",
      "diagram": {
        "type": "place-value-chart",
        "animate": true,
        "data": {
