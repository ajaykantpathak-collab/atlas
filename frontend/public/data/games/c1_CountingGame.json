  "slides": [
    {
      "title": "Numbers and Numerals 🍎",
      "text": "A number is the idea of how many things there are. A numeral is the written mark we use, like 7 or 15! Piku has 5 delicious red apples in her basket!",
      "emoji": "🍎",
      "bgColor": "from-red-400 to-rose-500",
      "spoken": "",
      "diagram": {
        "type": "place-value-chart",
        "animate": true,
        "data": {
          "columns": [
            "Crores",
