  {
   "title": "Numbers Climb to 100! 🪜",
   "text": "Numbers do not stop at 20! They climb on: 21, 22, 23... all the way up to 100! One hundred is 10 tens — the top of our number ladder!",
   "emoji": "🪜",
   "bgColor": "from-blue-400 to-indigo-500",
   "spoken": "Numbers go on past twenty, all the way to one hundred.",
