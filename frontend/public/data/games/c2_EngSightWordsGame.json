  {
   "title": "Sight Words are Stars ⭐",
   "text": "Some words we know INSTANTLY by sight — no sounding needed! 'the', 'is', 'and' — the, is, and!",
   "emoji": "⭐",
   "bgColor": "from-yellow-400 to-amber-500",
   "spoken": ""
  },
  {
   "title": "Why Sight Words? 👀",
   "text": "Sounding out 'the' letter-by-letter is slow. Instant sight words make reading FAST and smooth!",
   "emoji": "👀",
   "bgColor": "from-orange-400 to-red-500",
   "spoken": ""
  },
  {
   "title": "Snap! Know it Fast! ⚡",
   "text": "Flash a word for one second — can you read it? The: THE! Said: SAID! Practice makes instant!",
   "emoji": "⚡",
   "bgColor": "from-blue-400 to-indigo-500",
   "spoken": ""
  },
  {
   "title": "Sentence Sprinters 🏃",
   "text": "Sight words glue sentences: 'The cat is on the mat.' See them, say them, and the sentence flies!",
   "emoji": "🏃",
   "bgColor": "from-green-400 to-emerald-500",
   "spoken": ""
  },
  {
   "title": "Read to See 🌈",
   "text": "Every sentence has sight-word anchors. Grab them first and the sentence meaning clicks!",
   "emoji": "🌈",
   "bgColor": "from-purple-400 to-pink-500",
   "spoken": ""
  }
