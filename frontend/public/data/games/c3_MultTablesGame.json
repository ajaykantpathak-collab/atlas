 "slides": [
  {
   "title": "Tables are Skip-Counting 🦘",
   "text": "The 3-times table is just counting by 3s: 3, 6, 9, 12, 15...! Skip-count faster, multiply faster!",
   "emoji": "🦘",
   "bgColor": "from-green-400 to-teal-500",
   "spoken": ""
  },
  {
   "title": "Tables are Groups 📦",
   "text": "4 × 3 = 4 groups of 3 = 12. Multiplication is repeated addition done smart!",
   "emoji": "📦",
   "bgColor": "from-blue-400 to-indigo-500",
   "spoken": ""
  },
  {
   "title": "The Zero & One Rules 0️⃣",
   "text": "Anything × 0 = 0 (zero groups of anything is nothing!). Anything × 1 = itself!",
   "emoji": "0️⃣",
   "bgColor": "from-orange-400 to-amber-500",
   "spoken": ""
  },
  {
   "title": "Swap Works Both Ways 🔄",
   "text": "3 × 4 = 12 and 4 × 3 = 12 — same answer! Multiplication commutes!",
   "emoji": "🔄",
   "bgColor": "from-purple-400 to-violet-500",
   "spoken": ""
  },
  {
   "title": "Climb the Tower! 🗼",
   "text": "2s are easy (doubling!), 5s end in 5 or 0, 9s have a finger trick — every table has a shortcut!",
   "emoji": "🗼",
   "bgColor": "from-pink-400 to-rose-500",
   "spoken": ""
  }
 ],
