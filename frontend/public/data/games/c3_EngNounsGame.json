 "slides": [
  {
   "title": "What is a Noun? 🏷️",
   "text": "A noun is a NAMING word — for a person (teacher), place (school), thing (book), or animal (dog)!",
   "emoji": "🏷️",
   "bgColor": "from-blue-400 to-indigo-500",
   "spoken": ""
  },
  {
   "title": "Person, Place, Thing 🧍",
   "text": "'Mummy' = person. 'Park' = place. 'Ball' = thing. Every noun answers WHO or WHAT!",
   "emoji": "🧍",
   "bgColor": "from-green-400 to-emerald-500",
   "spoken": ""
  },
  {
   "title": "Common vs Special Nouns ⭐",
   "text": "'boy' is common (any boy). 'Ravi' is special (this exact boy) — special names get big letters!",
   "emoji": "⭐",
   "bgColor": "from-purple-400 to-violet-500",
   "spoken": ""
  },
  {
   "title": "Countable vs Uncountable 🥛",
   "text": "You can count 'pencils' but not 'water' — water needs a container. Some nouns pour, some count!",
   "emoji": "🥛",
   "bgColor": "from-orange-400 to-amber-500",
   "spoken": ""
  },
  {
   "title": "Noun Hunt 🔍",
   "text": "In 'The cat sat on the mat' — TWO nouns hide there. Hunt them!",
   "emoji": "🔍",
   "bgColor": "from-pink-400 to-rose-500",
   "spoken": ""
  }
 ],
