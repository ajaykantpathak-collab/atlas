 "slides": [
  {
   "title": "वाक्य विस्तार — Expanding ✍️",
   "text": "'राम खेलता है' → 'राम मैदान में क्रिकेट खेलता है' — add WHERE and WHAT to grow the sentence!",
   "emoji": "✍️",
   "bgColor": "from-indigo-400 to-purple-500",
   "spoken": ""
  },
  {
   "title": "और / लेकिन / क्योंकि 🔗",
   "text": "'और' joins similar ideas, 'लेकिन' contrasts, 'क्योंकि' gives a reason — connector words glue sentences!",
   "emoji": "🔗",
   "bgColor": "from-blue-400 to-cyan-500",
   "spoken": ""
  },
  {
   "title": "विराम चिह्न — Punctuation Marks 🛑",
   "text": "। full stop, ? question, ! exclamation, , pause — each mark shapes the sentence's voice!",
   "emoji": "🛑",
   "bgColor": "from-green-400 to-emerald-500",
   "spoken": ""
  },
  {
   "title": "अनुच्छेद — Paragraph 📄",
   "text": "Sentences about ONE idea form a paragraph. A paragraph = 3-4 sentences that support one point!",
   "emoji": "📄",
   "bgColor": "from-orange-400 to-amber-500",
   "spoken": ""
  },
  {
   "title": "क्रम — Order in Writing ⏳",
   "text": "A good paragraph flows: first the topic, then details, then the closing — like a mini-story!",
   "emoji": "⏳",
   "bgColor": "from-pink-400 to-rose-500",
   "spoken": ""
  }
 ],
