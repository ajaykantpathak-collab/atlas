  {
   "title": "कौन, क्या, कहाँ, क्यों 🔍",
   "text": "Four questions unlock any passage: who (कौन), what (क्या), where (कहाँ), why (क्यों)!",
   "emoji": "🔍",
   "bgColor": "from-green-400 to-emerald-500",
   "spoken": ""
  },
  {
   "title": "मुख्य विचार — Main Idea 🎯",
   "text": "The main idea is the one sentence the whole passage supports — everything else is detail!",
