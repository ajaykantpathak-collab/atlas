  {
   "title": "निष्कर्ष — Inference 🔎",
   "text": "'राम थक गया' implies he worked hard — the text hints, you conclude!",
   "emoji": "🔎",
   "bgColor": "from-orange-400 to-amber-500",
   "spoken": ""
  },
  {
