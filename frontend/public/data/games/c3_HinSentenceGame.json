 "slides": [
  {
   "title": "Sentence = Idea ✍️",
   "text": "A sentence tells a complete idea: 'राम खेलता है' (Ram plays). It has a doer (कर्ता) and an action (क्रिया)!",
   "emoji": "✍️",
   "bgColor": "from-indigo-400 to-purple-500",
   "spoken": ""
  },
  {
   "title": "कर्ता and क्रिया 🎭",
   "text": "Every sentence has WHO does it (कर्ता — Ram) and WHAT they do (क्रिया — plays). Find both!",
   "emoji": "🎭",
   "bgColor": "from-blue-400 to-cyan-500",
   "spoken": ""
  },
  {
   "title": "। — The Full Stop 🛑",
   "text": "Hindi sentences end with '।' (purna viram), not a dot! It's the sentence's closing bell!",
   "emoji": "🛑",
   "bgColor": "from-green-400 to-emerald-500",
   "spoken": ""
  },
  {
   "title": "विस्मयादिबोधक ! and प्रश्नवाचक ?",
   "text": "Feelings get '!': 'वाह! क्या खेल है!' Questions get '?': 'तुम कहाँ हो?'",
   "emoji": "❗",
   "bgColor": "from-orange-400 to-amber-500",
   "spoken": ""
  },
  {
   "title": "Word Order Matters 🔄",
   "text": "'राम ने रावण को हराया' — the order carries meaning. Swap it and the story changes!",
   "emoji": "🔄",
   "bgColor": "from-pink-400 to-rose-500",
   "spoken": ""
  }
 ],
