    {
      "title": "Markets & Post Offices! 🛒",
      "text": "We buy fruits, vegetables, and books at the market! The post office sorts and sends letters and parcels to people far away!",
      "emoji": "🛒",
      "bgColor": "from-amber-400 to-orange-500",
      "spoken": "",
      "diagram": {
        "type": "map-india",
