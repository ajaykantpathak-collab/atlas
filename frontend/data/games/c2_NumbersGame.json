            "Thousands",
            "Ones"
          ],
          "digits": [
            "1",
            "2",
            "3",
            "4"
          ]
        }
      }
    },
    {
      "title": "Ascending & Descending Order! 📈📉",
      "text": "Ascending means going UP from smallest to biggest (145, 235, 318). Descending means going DOWN from biggest to smallest (902, 789, 456)!",
