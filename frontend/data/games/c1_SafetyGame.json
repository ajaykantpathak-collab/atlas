    },
    {
      "title": "Sharp Objects & Fire 🔪🔥",
      "text": "Knives, scissors, and broken glass can cut our skin. Matchsticks, candles, and stoves can burn us. Never touch them without a grown-up beside you!",
      "emoji": "🔪",
      "bgColor": "from-red-400 to-rose-500",
      "spoken": "",
      "diagram": {
