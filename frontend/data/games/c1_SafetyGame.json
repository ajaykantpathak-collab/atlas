          ],
          "highlightIndex": 2
        }
      }
    },
    {
      "title": "Road Safety on Indian Roads 🚦🚶",
      "text": "Always hold a grown-up hand, walk on the footpath, and look left, then right, then left again before crossing the road where vehicles move fast!",
      "emoji": "🚦",
      "bgColor": "from-emerald-400 to-teal-500",
      "spoken": "",
      "diagram": {
        "type": "body-diagram",
