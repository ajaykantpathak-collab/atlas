          "highlightIndex": 1
        }
      }
    },
    {
      "title": "Electricity & Falls ⚡🪜",
      "text": "Never touch a switch or socket with wet hands because water carries electricity and gives a shock. Walk slowly on stairs and never climb chairs or tables!",
      "emoji": "⚡",
      "bgColor": "from-blue-400 to-indigo-500",
      "spoken": "",
      "diagram": {
        "type": "body-diagram",
