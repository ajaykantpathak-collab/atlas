    },
    {
      "title": "When You Get Hurt 🩹👩‍⚕️",
      "text": "If you get a cut or burn, never hide it! Tell a teacher, parent, or grown-up right away so they can give first aid and keep you safe!",
      "emoji": "🩹",
      "bgColor": "from-purple-400 to-indigo-600",
