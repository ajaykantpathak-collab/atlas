    {
      "title": "Sunny Day Fun! 🧢",
      "text": "On a sunny day, the sun shines brightly in a blue sky and we feel warm! We wear light cotton clothes and caps, and play outside in the park!",
      "emoji": "☀️",
      "bgColor": "from-yellow-400 to-orange-500",
      "spoken": "",
      "diagram": {
        "type": "map-india",
        "animate": true,
