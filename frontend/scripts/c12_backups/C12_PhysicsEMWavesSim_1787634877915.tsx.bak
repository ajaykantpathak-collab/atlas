// ─── Node IDs (string literals for verification) ────────────────────────────
const NODE_C12_PHY_072 = 'c12_phy_072'; // Displacement current
const NODE_C12_PHY_073 = 'c12_phy_073'; // EM waves (properties, speed)
const NODE_C12_PHY_074 = 'c12_phy_074'; // EM wave equation and transverse nature
const NODE_C12_PHY_075 = 'c12_phy_075'; // Electromagnetic spectrum
const ALL_NODE_IDS = [NODE_C12_PHY_072, NODE_C12_PHY_073, NODE_C12_PHY_074, NODE_C12_PHY_075];

// ─── Types ──────────────────────────────────────────────────────────────────

export interface C12_PhysicsEMWavesSimProps {
  nodeId?: string;
  title?: string;
  definition?: string;
  eli5?: string;
  misconceptions?: Array<{ belief: string; correction: string }>;
  diagnosticQuestions?: Array<{
    number: number;
    bloomLevel: string;
    question: string;
    answer: string;
    answerType?: 'number' | 'text' | 'mcq';
    unit?: string;
    formula?: string;
    working?: string;
    options?: string[];
    hint?: string;
  }>;
  masteryCriteria?: string;
  onComplete?: (score: number) => void;
}

type MasteryLevel = 'not-started' | 'beginner' | 'developing' | 'proficient' | 'mastered';
type DifficultyLevel = 'foundation' | 'standard' | 'advanced';
type TopicTab = 'displacement' | 'emwaves' | 'waveeqn' | 'spectrum';

interface BKTMap { [nodeId: string]: ReturnType<typeof createBKTState>; }

// ─── Physical constants ─────────────────────────────────────────────────────
const MU_0 = 4 * Math.PI * 1e-7;          // T·m/A
const EPS_0 = 8.854e-12;                   // C²/(N·m²)
const C_LIGHT = 1 / Math.sqrt(MU_0 * EPS_0); // ≈ 2.998e8 m/s

// ─── EM Spectrum data ───────────────────────────────────────────────────────
interface SpectrumBand {
  name: string;
  lambdaMin: number; // m (lower bound of wavelength)
  lambdaMax: number; // m (upper bound of wavelength)
  freqMin: number;   // Hz
  freqMax: number;   // Hz
  source: string;
  detector: string;
  uses: string;
  color: string;
  emoji: string;
}

const SPECTRUM_BANDS: SpectrumBand[] = [
  { name: 'Radio',     lambdaMin: 1e-1,    lambdaMax: 1e3,    freqMin: 3e5,    freqMax: 3e9,   source: 'Oscillating charges in antennas (LC circuits)', detector: 'Receiver antennas',           uses: 'AM/FM radio, TV broadcasting, mobile phones', color: '#FF6B6B', emoji: '📻' },
  { name: 'Microwave', lambdaMin: 1e-3,    lambdaMax: 1e-1,   freqMin: 3e9,    freqMax: 3e11,  source: 'Klystrons, magnetrons, Gunn diodes',          detector: 'Point-contact diodes, bolometers', uses: 'Radar, microwave ovens (2.45 GHz), Wi-Fi, satellite comm', color: '#FFA94D', emoji: '📡' },
  { name: 'Infrared',  lambdaMin: 7e-7,    lambdaMax: 1e-3,   freqMin: 3e11,   freqMax: 4.3e14, source: 'Hot bodies, molecular vibrations',           detector: 'Thermopiles, bolometers, IR film',  uses: 'Remote controls, thermal imaging, physiotherapy', color: '#E63946', emoji: '🔥' },
  { name: 'Visible',   lambdaMin: 4e-7,    lambdaMax: 7e-7,   freqMin: 4.3e14, freqMax: 7.5e14, source: 'Electronic transitions in excited atoms',    detector: 'Eye, photographic film, photocells', uses: 'Vision, photography, optical fibres',         color: '#FCE300', emoji: '💡' },
  { name: 'Ultraviolet', lambdaMin: 1e-9,  lambdaMax: 4e-7,   freqMin: 7.5e14, freqMax: 3e17,  source: 'Very hot bodies (Sun), mercury vapour lamps', detector: 'Photographic film, photocells, fluorescent materials', uses: 'Sterilisation, fluorescent lamps, forged-document detection', color: '#9D4EDD', emoji: '☀️' },
  { name: 'X-rays',    lambdaMin: 1e-13,   lambdaMax: 1e-8,   freqMin: 3e16,   freqMax: 3e21,  source: 'Coolidge tube (fast electrons on metal target)', detector: 'Photographic plates, ionisation chambers, Geiger counters', uses: 'Medical imaging, CT scans, crystallography, cancer therapy', color: '#4ECDC4', emoji: '🦴' },
  { name: 'Gamma',     lambdaMin: 1e-16,   lambdaMax: 1e-13,  freqMin: 3e21,   freqMax: 3e24,  source: 'Radioactive decay of nuclei',                 detector: 'Geiger-Muller tubes, scintillation counters', uses: 'Radiotherapy, sterilisation of equipment, food preservation', color: '#4D96FF', emoji: '☢️' },
];

// ─── Default enrichment props ───────────────────────────────────────────────
const DEFAULT_PROPS: Required<Omit<C12_PhysicsEMWavesSimProps, 'onComplete'>> = {
  nodeId: 'c12_phy_072',
  title: 'Electromagnetic Waves — Maxwell to the Spectrum',
  definition:
    'Electromagnetic (EM) waves are self-propagating oscillations of mutually perpendicular electric (E) and magnetic (B) fields that travel through space at the speed of light c = 1/√(μ₀ε₀) ≈ 3×10⁸ m/s, requiring no material medium. Maxwell introduced the displacement current I_d = ε₀(dΦ_E/dt) to make Ampere\u2019s law consistent with charge conservation; combined with Faraday\u2019s law this yields a feedback loop in which a changing E produces a changing B and vice-versa, allowing the wave to sustain itself even in vacuum. The wave equations ∇²E = (1/c²)∂²E/∂t² and ∇²B = (1/c²)∂²B/∂t² follow, with sinusoidal solutions E = E₀ sin(kx − ωt) and B = B₀ sin(kx − ωt) in phase, E⊥B⊥c, and E₀/B₀ = c. The full EM spectrum — radio, microwave, infrared, visible, ultraviolet, X-rays, gamma rays — shares these properties and differs only in wavelength and frequency.',
