    },
  ],
  masteryCriteria:
    'Can state I_d = ε₀(dΦ_E/dt) and derive I_d = I_c for a charging capacitor; can write the Ampere–Maxwell law; can describe EM waves as self-propagating transverse oscillations with E⊥B⊥c at speed c = 1/√(μ₀ε₀) ≈ 3×10⁸ m/s; can write the wave equations and sinusoidal solutions in phase with E₀/B₀ = c; can list the EM spectrum in order of increasing frequency with source, detector, and use for each region.',
};

// ─── Utility: numeric answer comparison with tolerance ──────────────────────
function approxEqual(a: string, b: string, tol: number = 0.02): boolean {
  const na = parseFloat(a.trim());
  const nb = parseFloat(b.trim());
  if (Number.isNaN(na) || Number.isNaN(nb)) return a.trim().toLowerCase() === b.trim().toLowerCase();
  return Math.abs(na - nb) <= tol * Math.max(Math.abs(nb), 1e-12);
}

// ─── Helper: format scientific notation ─────────────────────────────────────
function fmtSci(x: number, digits: number = 3): string {
  if (x === 0) return '0';
  const exp = Math.floor(Math.log10(Math.abs(x)));
  const mant = x / Math.pow(10, exp);
  return `${mant.toFixed(digits)}×10${superscript(exp)}`;
}
function superscript(n: number): string {
  const map: Record<string, string> = { '-': '⁻', '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹' };
  return String(n).split('').map((c) => map[c] || c).join('');
}

// ═══════════════════════════════════════════════════════════════════════════
// MAIN COMPONENT
// ═══════════════════════════════════════════════════════════════════════════
export default function C12_PhysicsEMWavesSim(props: C12_PhysicsEMWavesSimProps) {
  const merged = { ...DEFAULT_PROPS, ...props };
  const {
    nodeId,
    title,
    definition,
    eli5,
    misconceptions,
    diagnosticQuestions,
    masteryCriteria,
    onComplete,
  } = merged;

  // ─── Topic / tab state ───────────────────────────────────────────────────
  const [activeTopic, setActiveTopic] = useState<TopicTab>('displacement');
  const [activeInfoTab, setActiveInfoTab] = useState<'eli5' | 'theory' | 'misconceptions'>('eli5');
  const [guidedStep, setGuidedStep] = useState<number>(1);
  const [hasExplored, setHasExplored] = useState<boolean>(false);

  // ─── Adaptive difficulty & mastery (BKT per node) ────────────────────────
  const [bktStates, setBktStates] = useState<BKTMap>(() => {
    const init: BKTMap = {};
    for (const id of ALL_NODE_IDS) init[id] = createBKTState();
    return init;
  });
  const [difficultyLevel, setDifficultyLevel] = useState<DifficultyLevel>('standard');
  const [streak, setStreak] = useState<number>(0);
  const [wrongStreak, setWrongStreak] = useState<number>(0);

  // ─── Challenge state ─────────────────────────────────────────────────────
  const [currentChallengeIdx, setCurrentChallengeIdx] = useState<number>(0);
  const [studentAnswer, setStudentAnswer] = useState<string>('');
  const [challengeFeedback, setChallengeFeedback] = useState<{
    status: 'correct' | 'wrong' | 'idle';
    message: string;
    working?: string;
  }>({ status: 'idle', message: '' });
  const [retryCount, setRetryCount] = useState<number>(0);
  const [score, setScore] = useState<number>(0);
  const [errors, setErrors] = useState<number>(0);
  const [challengeCompleted, setChallengeCompleted] = useState<boolean>(false);
  const [guidedSubStep, setGuidedSubStep] = useState<number>(0);

  // ─── Hint system ─────────────────────────────────────────────────────────
  const [hintLevel, setHintLevel] = useState<number>(0);
  const [showHintButton, setShowHintButton] = useState<boolean>(false);
  const lastInteractionTime = useRef<number>(Date.now());

  // ─── Feedback visuals ────────────────────────────────────────────────────
  const [sparkle, setSparkle] = useState<{ x: number; y: number; id: number } | null>(null);
  const [confettiOn, setConfettiOn] = useState<boolean>(false);
  const [successMsg, setSuccessMsg] = useState<string | null>(null);
  const [hintMsg, setHintMsg] = useState<string | null>(null);

  // ─── Real-world activity response ────────────────────────────────────────
  const [activityText, setActivityText] = useState<string>('');
  const [activitySubmitted, setActivitySubmitted] = useState<boolean>(false);

  // ─── Saved mastery / review badge ────────────────────────────────────────
  const [savedMastery, setSavedMastery] = useState<{ bestScore: number; status: string } | null>(null);
  const [dueForReview, setDueForReview] = useState<boolean>(false);

  // ─── Capacitor simulation state (node 072) ───────────────────────────────
  const [chargeCurrent, setChargeCurrent] = useState<number>(5); // mA
  const [plateArea, setPlateArea] = useState<number>(0.02); // m²
  const [capVoltage, setCapVoltage] = useState<number>(0); // V across capacitor (animated)
  const [showBulgingSurface, setShowBulgingSurface] = useState<boolean>(false);
  const [animatingCharge, setAnimatingCharge] = useState<boolean>(false);
  const capAnimRef = useRef<number | null>(null);

  // ─── EM wave propagation state (node 073/074) ────────────────────────────
  const [waveAmplitude, setWaveAmplitude] = useState<number>(100); // E₀ in V/m
  const [waveFrequency, setWaveFrequency] = useState<number>(5); // ×10¹⁴ Hz (visible range)
  const [waveTime, setWaveTime] = useState<number>(0);
  const [showBField, setShowBField] = useState<boolean>(true);
  const [propagationDir, setPropagationDir] = useState<'+x' | '-x'>('+x');
  const waveAnimRef = useRef<number | null>(null);
  const [wavePlaying, setWavePlaying] = useState<boolean>(true);

  // ─── Spectrum explorer state (node 075) ──────────────────────────────────
  const [selectedBand, setSelectedBand] = useState<number>(3); // default visible
  const [spectrumLambdaInput, setSpectrumLambdaInput] = useState<number>(600); // nm
  const [spectrumUnit, setSpectrumUnit] = useState<'nm' | 'um' | 'mm' | 'm' | 'angstrom'>('nm');

  // ─── Load saved mastery on mount ─────────────────────────────────────────
  useEffect(() => {
    if (typeof window === 'undefined') return;
    const m = getNodeMastery(nodeId || NODE_C12_PHY_072);
    if (m) {
      setSavedMastery({ bestScore: m.bestScore, status: m.status });
      if (m.status === 'needs_review') setDueForReview(true);
    }
    // Load BKT states from localStorage
    try {
      const raw = localStorage.getItem('c12_physics_C12_PhysicsEMWavesSim_mastery');
      if (raw) {
        const parsed = JSON.parse(raw) as BKTMap;
        setBktStates((prev) => {
          const next = { ...prev };
          for (const id of ALL_NODE_IDS) if (parsed[id]) next[id] = parsed[id];
          return next;
        });
      }
    } catch {
      /* ignore */
    }
  }, [nodeId]);

  // ─── Persist BKT states ──────────────────────────────────────────────────
  const persistBKT = useCallback((next: BKTMap) => {
    if (typeof window !== 'undefined') {
      try {
        localStorage.setItem('c12_physics_C12_PhysicsEMWavesSim_mastery', JSON.stringify(next));
      } catch {
        /* ignore */
      }
    }
  }, []);

  // ─── Inactivity hint timer ───────────────────────────────────────────────
  useEffect(() => {
    const interval = setInterval(() => {
      if (
        Date.now() - lastInteractionTime.current > 10000 &&
        hintLevel === 0 &&
        !challengeCompleted &&
        challengeFeedback.status === 'idle'
      ) {
        setShowHintButton(true);
      }
    }, 1000);
    return () => clearInterval(interval);
  }, [hintLevel, challengeCompleted, challengeFeedback.status]);

  const handleInteraction = useCallback(() => {
    lastInteractionTime.current = Date.now();
    setHasExplored(true);
    if (guidedStep === 1) setGuidedStep(2);
    setShowHintButton(false);
  }, [guidedStep]);

  // ─── Adaptive difficulty logic ───────────────────────────────────────────
  const adjustDifficulty = useCallback(
    (isCorrect: boolean) => {
      if (isCorrect) {
        setStreak((s) => {
          const ns = s + 1;
          if (ns >= 3) {
            setDifficultyLevel((d) => (d === 'foundation' ? 'standard' : d === 'standard' ? 'advanced' : d));
            return 0;
          }
          return ns;
        });
        setWrongStreak(0);
      } else {
        setWrongStreak((w) => {
          const nw = w + 1;
          if (nw >= 2) {
            setDifficultyLevel((d) => (d === 'advanced' ? 'standard' : d === 'standard' ? 'foundation' : d));
            return 0;
          }
          return nw;
        });
        setStreak(0);
      }
    },
    [],
  );

  // ─── Update BKT for a node ───────────────────────────────────────────────
  const updateBKTForNode = useCallback(
    (id: string, isCorrect: boolean) => {
      setBktStates((prev) => {
        const cur = prev[id] || createBKTState();
        const next = bktUpdate(cur, isCorrect);
        const mergedMap: BKTMap = { ...prev, [id]: next };
        persistBKT(mergedMap);
        return mergedMap;
      });
    },
    [persistBKT],
  );

  // ─── Spaced repetition save ──────────────────────────────────────────────
  const saveSRS = useCallback((id: string, conceptName: string, quality: number, responseTime: number) => {
    const item = createReviewItem(id, conceptName);
    // Try to load existing review history
    let base = item;
    if (typeof window !== 'undefined') {
      try {
        const raw = localStorage.getItem(`srs_${id}`);
        if (raw) base = JSON.parse(raw) as typeof item;
      } catch {
        /* ignore */
      }
    }
    const updated = sm2Update(base, quality, responseTime);
    if (typeof window !== 'undefined') {
      try {
        localStorage.setItem(`srs_${id}`, JSON.stringify(updated));
      } catch {
        /* ignore */
      }
    }
  }, []);

  // ─── EM wave animation loop ──────────────────────────────────────────────
  useEffect(() => {
    if (!wavePlaying) return;
    let last = performance.now();
    const loop = (now: number) => {
      const dt = (now - last) / 1000;
      last = now;
      setWaveTime((t) => (t + dt) % 1000);
      waveAnimRef.current = requestAnimationFrame(loop);
    };
    waveAnimRef.current = requestAnimationFrame(loop);
    return () => {
      if (waveAnimRef.current) cancelAnimationFrame(waveAnimRef.current);
    };
  }, [wavePlaying]);

  // ─── Capacitor charging animation ────────────────────────────────────────
  const startCharging = useCallback(() => {
    handleInteraction();
    if (capAnimRef.current) cancelAnimationFrame(capAnimRef.current);
    setAnimatingCharge(true);
    setCapVoltage(0);
    const targetV = 12;
    const tau = 0.6; // seconds (visual)
    const start = performance.now();
    const step = (now: number) => {
      const t = (now - start) / 1000;
      const v = targetV * (1 - Math.exp(-t / tau));
      setCapVoltage(v);
      if (v < targetV - 0.05) {
        capAnimRef.current = requestAnimationFrame(step);
      } else {
        setCapVoltage(targetV);
        setAnimatingCharge(false);
      }
    };
    capAnimRef.current = requestAnimationFrame(step);
  }, [handleInteraction]);

  useEffect(() => {
    return () => {
      if (capAnimRef.current) cancelAnimationFrame(capAnimRef.current);
      if (waveAnimRef.current) cancelAnimationFrame(waveAnimRef.current);
    };
  }, []);

  // ─── Derived capacitor quantities ────────────────────────────────────────
  const dEdt = chargeCurrent * 1e-3 / (EPS_0 * plateArea); // V/(m·s)
  const displacementCurrent = chargeCurrent; // mA (equals conduction current)
  const phiE_rate = (chargeCurrent * 1e-3) / EPS_0; // V·m/s

  // ─── Derived EM wave quantities ──────────────────────────────────────────
  const fActual = waveFrequency * 1e14; // Hz
  const lambdaActual = C_LIGHT / fActual; // m
  const B0 = waveAmplitude / C_LIGHT; // T
  const k = 2 * Math.PI / lambdaActual;
  const omega = 2 * Math.PI * fActual;
  // For display we scale wavelength to a visual pixel size
  const visualLambda = 220; // px per wavelength on canvas
  const visualK = (2 * Math.PI) / visualLambda;

  // ─── Spectrum derived ────────────────────────────────────────────────────
  const lambdaInMetres = useMemo(() => {
    const v = spectrumLambdaInput;
    switch (spectrumUnit) {
      case 'nm': return v * 1e-9;
      case 'um': return v * 1e-6;
      case 'mm': return v * 1e-3;
      case 'm': return v;
      case 'angstrom': return v * 1e-10;
      default: return v * 1e-9;
    }
  }, [spectrumLambdaInput, spectrumUnit]);
  const freqFromLambda = lambdaInMetres > 0 ? C_LIGHT / lambdaInMetres : 0;
  const bandForLambda = useMemo(() => {
    return SPECTRUM_BANDS.findIndex(
      (b) => lambdaInMetres >= b.lambdaMin && lambdaInMetres <= b.lambdaMax,
    );
  }, [lambdaInMetres]);

  // ─── Mastery level display ───────────────────────────────────────────────
  const activeNodeId = useMemo<TopicToNode>(() => {
    return {
      displacement: NODE_C12_PHY_072,
      emwaves: NODE_C12_PHY_073,
      waveeqn: NODE_C12_PHY_074,
      spectrum: NODE_C12_PHY_075,
    } as TopicToNode;
  }, []);
  const currentMastery: MasteryLevel = useMemo(() => {
    const id = activeNodeId[activeTopic];
    return getMasteryLevel(bktStates[id]?.pKnown ?? 0);
  }, [bktStates, activeTopic, activeNodeId]);

  // ─── Challenge question (with variant on retry) ──────────────────────────
  const activeQuestion = useMemo(() => {
    const base = diagnosticQuestions[currentChallengeIdx] || DEFAULT_PROPS.diagnosticQuestions[currentChallengeIdx];
    if (retryCount === 0) return base;
    // Generate a DIFFERENT variant of the same concept
    if (currentChallengeIdx === 1) {
      const dynI = (3 + retryCount * 2) * 1e-3; // A
      const dynA = 0.01 + retryCount * 0.01; // m²
      const dynAns = dynI / (EPS_0 * dynA);
      return {
        ...base,
        question: `[VARIANT] A capacitor of area A = ${dynA.toFixed(3)} m² is charged by I = ${(dynI * 1000).toFixed(0)} mA. Find dE/dt (V·m⁻¹·s⁻¹, scientific notation like X.XXeYY).`,
        answer: dynAns.toExponential(2),
        working: `dE/dt = I/(ε₀A) = ${(dynI * 1000).toFixed(0)}e-3 / (8.854e-12 × ${dynA.toFixed(3)}) = ${dynAns.toExponential(2)} V·m⁻¹·s⁻¹.`,
      };
    }
    if (currentChallengeIdx === 2) {
      // Different propagation direction variant
      return {
        ...base,
        question: `[VARIANT] An EM wave travels along −x with E = E₀ sin(kx + ωt) ĵ. What is the direction of B? Compute c (m/s, e.g. 2.998e8).`,
        answer: '2.998e8',
        working: 'For −x propagation, B must be along −z (so E×B = ĵ×(−k̂) = −î = −x). c = 1/√(μ₀ε₀) ≈ 2.998×10⁸ m/s.',
      };
    }
    if (currentChallengeIdx === 4) {
      const dynF = (2 + retryCount) * 1e9; // Hz
      const dynLambda = (C_LIGHT / dynF) * 100; // cm
      return {
        ...base,
        question: `[VARIANT] A radar uses f = ${(dynF / 1e9).toFixed(0)} GHz. Find λ in cm (1 decimal). Name the producing device.`,
        answer: dynLambda.toFixed(1),
        working: `λ = c/f = 3e8 / ${(dynF / 1e9).toFixed(0)}e9 = ${dynLambda.toFixed(1)} cm. Produced by a klystron or magnetron.`,
      };
    }
    return base;
  }, [currentChallengeIdx, retryCount, diagnosticQuestions]);

  // ─── Submit answer ───────────────────────────────────────────────────────
  const handleSubmitAnswer = useCallback(() => {
    handleInteraction();
    const q = activeQuestion;
    if (!q) return;
    const startTime = lastInteractionTime.current;
    const responseTime = Date.now() - startTime;
    let isCorrect = false;
    if (q.answerType === 'mcq') {
      isCorrect = studentAnswer.trim().toLowerCase() === q.answer.trim().toLowerCase();
    } else if (q.answerType === 'number' || /e[+-]?\d/i.test(q.answer)) {
      isCorrect = approxEqual(studentAnswer, q.answer, 0.03);
    } else {
      // text: check key tokens
      const ans = q.answer.toLowerCase();
      const stu = studentAnswer.toLowerCase();
      isCorrect = ans.split(/[ ,.;]+/).filter((w) => w.length > 3).every((w) => stu.includes(w)) || stu.includes(ans);
    }

    const targetNodeId = [NODE_C12_PHY_072, NODE_C12_PHY_073, NODE_C12_PHY_074, NODE_C12_PHY_075, NODE_C12_PHY_075][currentChallengeIdx];
    updateBKTForNode(targetNodeId, isCorrect);
    const quality = isCorrect ? (responseTime < 30000 ? 5 : 4) : retryCount > 0 ? 1 : 2;
    saveSRS(targetNodeId, title || 'EM Waves', quality, responseTime);
    adjustDifficulty(isCorrect);

    if (isCorrect) {
      const pts = difficultyLevel === 'advanced' ? 25 : difficultyLevel === 'standard' ? 22 : 18;
      setScore((s) => Math.min(s + pts, 100));
      setChallengeFeedback({ status: 'correct', message: 'Excellent! Your reasoning matches the physics.', working: q.working });
      audioManager.play('success');
      speechManager.speak('Correct! Well done.');
      setSuccessMsg('Correct! 🎉');
      setSparkle({ x: 200, y: 200, id: Date.now() });
    } else {
      setErrors((e) => e + 1);
      // Find matching misconception
      const mc = misconceptions.find((m) => {
        if (currentChallengeIdx === 0) return m.belief.includes('Displacement');
        if (currentChallengeIdx === 1) return m.belief.includes('Displacement');
        if (currentChallengeIdx === 2) return m.belief.includes('in phase');
        if (currentChallengeIdx === 3) return m.belief.includes('90°') || m.belief.includes('in phase');
        if (currentChallengeIdx === 4) return m.belief.includes('Radio waves and microwaves');
        return false;
      }) || misconceptions[0];
      setChallengeFeedback({
        status: 'wrong',
        message: `Misconception: ${mc.belief} → Correction: ${mc.correction}`,
        working: q.working,
      });
      audioManager.play('error');
      setHintMsg('Try a different variant of the same concept — see the hint below.');
      // After 2 wrong, break into guided sub-steps
      if (retryCount >= 1) {
        setGuidedSubStep(1);
        setHintMsg('Let\u2019s break this into smaller guided steps.');
      }
    }
  }, [activeQuestion, studentAnswer, currentChallengeIdx, retryCount, difficultyLevel, misconceptions, title, updateBKTForNode, saveSRS, adjustDifficulty, handleInteraction]);

  // ─── Next challenge ──────────────────────────────────────────────────────
  const handleNextChallenge = useCallback(() => {
    setStudentAnswer('');
    setChallengeFeedback({ status: 'idle', message: '' });
    setHintLevel(0);
    setShowHintButton(false);
    setGuidedSubStep(0);
    setRetryCount(0);
    if (currentChallengeIdx < diagnosticQuestions.length - 1) {
      setCurrentChallengeIdx((i) => i + 1);
    } else {
      setChallengeCompleted(true);
      const finalScore = Math.max(0, 100 - errors * 5);
      setScore(finalScore);
      recordGameScore(ALL_NODE_IDS, finalScore);
      if (onComplete) onComplete(finalScore);
      audioManager.play('celebration');
      setConfettiOn(true);
      speechManager.speak('Congratulations! You have completed the electromagnetic waves mastery challenge.');
    }
  }, [currentChallengeIdx, diagnosticQuestions.length, errors, onComplete]);

  const handleRetryVariant = useCallback(() => {
    setRetryCount((r) => r + 1);
    setStudentAnswer('');
    setChallengeFeedback({ status: 'idle', message: '' });
    setHintLevel(0);
    setShowHintButton(false);
  }, []);

  const handleShowHint = useCallback(() => {
    handleInteraction();
    setHintLevel((h) => Math.min(h + 1, 3));
    audioManager.play('hint');
    const q = activeQuestion;
    if (q?.hint) setHintMsg(q.hint);
  }, [activeQuestion, handleInteraction]);

  // ─── Activity submission ─────────────────────────────────────────────────
  const handleActivitySubmit = useCallback(() => {
    handleInteraction();
    setActivitySubmitted(true);
    if (activityText.trim().length > 30) {
      audioManager.play('chime');
      setSuccessMsg('Activity recorded! Great reflection.');
      setSparkle({ x: 300, y: 300, id: Date.now() });
    }
  }, [activityText, handleInteraction]);

  // ═════════════════════════════════════════════════════════════════════════
  // RENDER
  // ═════════════════════════════════════════════════════════════════════════
  const subjectCfg = SUBJECT_CONFIG['physics'];

  return (
    <div className="max-w-5xl mx-auto px-4 py-8 bg-slate-50 min-h-screen text-slate-800 font-sans">
      {/* Feedback overlays */}
      {sparkle && <SparkleBurst x={sparkle.x} y={sparkle.y} onComplete={() => setSparkle(null)} />}
      {confettiOn && <Confetti onComplete={() => setConfettiOn(false)} />}
      {successMsg && <SuccessBanner message={successMsg} onComplete={() => setSuccessMsg(null)} />}
      {hintMsg && <HintBubble message={hintMsg} onComplete={() => setHintMsg(null)} />}

      {/* Header */}
      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-slate-200 pb-4 mb-6">
        <div className="flex items-center gap-3">
          <span className="text-3xl">{subjectCfg.emoji}</span>
          <div>
            <h1 className="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">{title}</h1>
            <p className="text-sm text-slate-500 mt-1">
              CISCE Class 12 Physics · {subjectCfg.name} · Electromagnetic Waves
            </p>
          </div>
        </div>
        <div className="flex flex-wrap gap-2 mt-3 sm:mt-0">
          <span className="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 uppercase tracking-wider">
            {difficultyLevel} Mode
          </span>
          <span className="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-violet-100 text-violet-800 uppercase tracking-wider">
            Mastery: {currentMastery}
          </span>
          {dueForReview && (
            <span className="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">
              Review Session
            </span>
          )}
          {savedMastery && savedMastery.bestScore > 0 && (
            <span className="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
              Best: {savedMastery.bestScore}/100
            </span>
          )}
        </div>
      </div>

      {/* Guided discovery prompt */}
      {guidedStep === 1 && (
        <motion.div
          initial={{ opacity: 0, y: -10 }}
          animate={{ opacity: 1, y: 0 }}
          className="mb-6 p-4 bg-amber-50 border border-amber-200 rounded-xl text-amber-900 text-sm flex items-start gap-3"
        >
          <span className="text-lg">💡</span>
          <div>
            <p className="font-semibold">Guided Discovery Phase</p>
            <p className="mt-1">
              Before reading the formal laws, try the interactive simulations below. Charge the capacitor and
              watch the displacement current, animate the EM wave and observe E⊥B⊥c, and explore the spectrum.
              What patterns do you notice <em>before</em> the formulas are revealed?
            </p>
          </div>
        </motion.div>
      )}

      {/* Topic selector */}
      <div className="mb-6">
        <div className="grid grid-cols-2 sm:grid-cols-4 gap-2">
          {([
            { id: 'displacement' as TopicTab, label: 'Displacement Current', node: NODE_C12_PHY_072 },
            { id: 'emwaves' as TopicTab, label: 'EM Waves & Speed', node: NODE_C12_PHY_073 },
            { id: 'waveeqn' as TopicTab, label: 'Wave Equation', node: NODE_C12_PHY_074 },
            { id: 'spectrum' as TopicTab, label: 'EM Spectrum', node: NODE_C12_PHY_075 },
          ]).map((t) => {
            const m = getMasteryLevel(bktStates[t.node]?.pKnown ?? 0);
            return (
              <button
                key={t.id}
                onClick={() => { setActiveTopic(t.id); handleInteraction(); }}
                className={`py-3 px-3 rounded-xl text-xs sm:text-sm font-semibold border-2 transition-all ${
                  activeTopic === t.id
                    ? 'bg-indigo-600 text-white border-indigo-600 shadow-md'
                    : 'bg-white text-slate-600 border-slate-200 hover:border-indigo-300'
                }`}
              >
                <div>{t.label}</div>
                <div className={`text-[10px] mt-1 font-normal ${activeTopic === t.id ? 'text-indigo-100' : 'text-slate-400'}`}>
                  {t.node} · {m}
                </div>
              </button>
            );
          })}
        </div>
      </div>

      {/* Info tabs (ELI5 / Theory / Misconceptions) */}
      <div className="mb-6">
        <div className="flex border-b border-slate-200">
          {(['eli5', 'theory', 'misconceptions'] as const).map((tab) => (
            <button
              key={tab}
              onClick={() => { setActiveInfoTab(tab); handleInteraction(); }}
              className={`py-2 px-4 text-sm font-medium border-b-2 transition-colors ${
                activeInfoTab === tab ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700'
              }`}
            >
              {tab === 'eli5' ? 'ELI5 (Simple Analogy)' : tab === 'theory' ? 'Formal Theory' : 'Common Misconceptions'}
            </button>
          ))}
        </div>
        <div className="mt-4 p-5 bg-white rounded-xl shadow-sm border border-slate-100 min-h-[120px]">
          <AnimatePresence mode="wait">
            {activeInfoTab === 'eli5' && (
              <motion.div key="eli5" initial={{ opacity: 0, y: 5 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0 }} className="text-slate-600 text-sm leading-relaxed">
                <p className="font-medium text-slate-900 mb-2">How to think about this:</p>
                <p>{eli5}</p>
              </motion.div>
            )}
            {activeInfoTab === 'theory' && (
              <motion.div key="theory" initial={{ opacity: 0, y: 5 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0 }} className="text-slate-600 text-sm leading-relaxed whitespace-pre-line">
                <p className="font-medium text-slate-900 mb-2">Formal definition:</p>
                <p>{definition}</p>
                <p className="mt-3 text-xs text-slate-500">Mastery criteria: {masteryCriteria}</p>
              </motion.div>
            )}
            {activeInfoTab === 'misconceptions' && (
              <motion.div key="misconceptions" initial={{ opacity: 0, y: 5 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0 }} className="space-y-4 text-sm">
                {misconceptions.map((item, idx) => (
                  <div key={idx} className="border-l-4 border-rose-400 pl-3 py-1">
                    <p className="font-semibold text-slate-900">Misconception: {item.belief}</p>
                    <p className="text-slate-600 mt-1">→ Correction: {item.correction}</p>
                  </div>
                ))}
              </motion.div>
            )}
          </AnimatePresence>
        </div>
      </div>

      {/* ─── Interactive simulation per topic ─────────────────────────────── */}
      <div className="bg-slate-900 rounded-2xl shadow-xl overflow-hidden border border-slate-800 mb-8">
        <div className="p-5">
          <AnimatePresence mode="wait">
            {/* ─── DISPLACEMENT CURRENT SIM (node 072) ─── */}
            {activeTopic === 'displacement' && (
              <motion.div key="disp" initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}>
                <h2 className="text-white text-lg font-bold mb-1">Charging Capacitor &amp; Displacement Current</h2>
                <p className="text-slate-400 text-xs mb-4">
                  Node {NODE_C12_PHY_072} · Watch conduction current in the wires become displacement current in the gap.
                </p>

                {/* Circuit SVG diagram */}
                <div className="bg-slate-950 rounded-xl p-4 mb-4 overflow-x-auto">
                  <svg viewBox="0 0 600 280" className="w-full h-auto" style={{ maxWidth: 600 }}>
                    {/* Wires */}
                    <line x1="60" y1="80" x2="540" y2="80" stroke="#475569" strokeWidth="3" />
                    <line x1="60" y1="80" x2="60" y2="200" stroke="#475569" strokeWidth="3" />
                    <line x1="540" y1="80" x2="540" y2="200" stroke="#475569" strokeWidth="3" />
                    <line x1="60" y1="200" x2="220" y2="200" stroke="#475569" strokeWidth="3" />
                    <line x1="380" y1="200" x2="540" y2="200" stroke="#475569" strokeWidth="3" />
                    {/* Battery */}
                    <line x1="220" y1="190" x2="220" y2="210" stroke="#FBBF24" strokeWidth="4" />
                    <line x1="235" y1="180" x2="235" y2="220" stroke="#FBBF24" strokeWidth="4" />
                    <text x="225" y="245" fill="#FBBF24" fontSize="12">12 V</text>
                    {/* Resistor */}
                    <rect x="290" y="192" width="60" height="16" fill="none" stroke="#F87171" strokeWidth="2" />
                    <text x="305" y="240" fill="#F87171" fontSize="11">R</text>
                    {/* Capacitor plates */}
                    <line x1="250" y1="170" x2="250" y2="230" stroke="#60A5FA" strokeWidth="4" />
                    <line x1="270" y1="170" x2="270" y2="230" stroke="#60A5FA" strokeWidth="4" />
                    <text x="240" y="160" fill="#60A5FA" fontSize="11">+q</text>
                    <text x="265" y="160" fill="#60A5FA" fontSize="11">−q</text>
                    {/* E field arrows between plates */}
                    {Array.from({ length: 5 }).map((_, i) => {
                      const y = 180 + i * 10;
                      const len = 12 + (capVoltage / 12) * 8;
                      return (
                        <g key={i}>
                          <line x1={255 - len / 2} y1={y} x2={255 + len / 2} y2={y} stroke="#22D3EE" strokeWidth="1.5" markerEnd="url(#arrowE)" />
                        </g>
                      );
                    })}
                    <defs>
                      <marker id="arrowE" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
                        <path d="M0,0 L6,3 L0,6 Z" fill="#22D3EE" />
                      </marker>
                      <marker id="arrowI" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
                        <path d="M0,0 L6,3 L0,6 Z" fill="#FBBF24" />
                      </marker>
                      <marker id="arrowB" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
                        <path d="M0,0 L6,3 L0,6 Z" fill="#F472B6" />
                      </marker>
                    </defs>
                    {/* Conduction current arrows (in wires) */}
                    <line x1="100" y1="70" x2="140" y2="70" stroke="#FBBF24" strokeWidth="2" markerEnd="url(#arrowI)" />
                    <line x1="460" y1="90" x2="420" y2="90" stroke="#FBBF24" strokeWidth="2" markerEnd="url(#arrowI)" />
                    <text x="110" y="60" fill="#FBBF24" fontSize="11">I_c (wire)</text>
                    {/* Displacement current arrow (between plates) */}
                    <line x1="252" y1="195" x2="268" y2="195" stroke="#F472B6" strokeWidth="2" strokeDasharray="3,2" markerEnd="url(#arrowB)" />
                    <text x="280" y="200" fill="#F472B6" fontSize="11">I_d (gap)</text>
                    {/* Amperian surfaces */}
                    <ellipse cx="100" cy="80" rx="18" ry="14" fill="rgba(34,211,238,0.15)" stroke="#22D3EE" strokeWidth="1.5" />
                    <text x="80" y="115" fill="#22D3EE" fontSize="10">S₁ (cuts wire)</text>
                    {showBulgingSurface && (
                      <>
                        <path d="M 100 80 Q 200 130 260 200 Q 200 90 100 80 Z" fill="rgba(244,114,182,0.12)" stroke="#F472B6" strokeWidth="1.5" strokeDasharray="4,3" />
                        <text x="180" y="135" fill="#F472B6" fontSize="10">S₂ (bulges between plates)</text>
                      </>
                    )}
                    {/* Labels */}
                    <text x="20" y="50" fill="#94A3B8" fontSize="11">Conduction current I = dq/dt in wires</text>
                    <text x="20" y="265" fill="#94A3B8" fontSize="11">Displacement current I_d = ε₀(dΦ_E/dt) in gap</text>
                  </svg>
                </div>

                {/* Controls */}
                <div className="grid sm:grid-cols-2 gap-4 mb-4">
                  <div className="bg-slate-800 rounded-lg p-3">
                    <label className="text-slate-300 text-xs block mb-1">
                      Conduction current I: <span className="text-amber-300 font-mono">{chargeCurrent.toFixed(1)} mA</span>
                    </label>
                    <input
                      type="range" min={1} max={20} step={0.5} value={chargeCurrent}
                      onChange={(e) => { setChargeCurrent(parseFloat(e.target.value)); handleInteraction(); }}
                      className="w-full accent-amber-400"
                    />
                  </div>
                  <div className="bg-slate-800 rounded-lg p-3">
                    <label className="text-slate-300 text-xs block mb-1">
                      Plate area A: <span className="text-cyan-300 font-mono">{(plateArea * 1000).toFixed(1)}×10⁻³ m²</span>
                    </label>
                    <input
                      type="range" min={0.005} max={0.05} step={0.001} value={plateArea}
                      onChange={(e) => { setPlateArea(parseFloat(e.target.value)); handleInteraction(); }}
                      className="w-full accent-cyan-400"
                    />
                  </div>
                </div>

                <div className="flex flex-wrap gap-2 mb-4">
                  <button
                    onClick={startCharging}
                    disabled={animatingCharge}
                    className="px-4 py-2 rounded-lg bg-amber-500 hover:bg-amber-400 disabled:opacity-50 text-slate-900 text-sm font-semibold"
                  >
                    {animatingCharge ? 'Charging…' : '⚡ Start Charging'}
                  </button>
                  <button
                    onClick={() => { setShowBulgingSurface((s) => !s); handleInteraction(); }}
                    className={`px-4 py-2 rounded-lg text-sm font-semibold ${showBulgingSurface ? 'bg-pink-500 text-white' : 'bg-slate-700 text-slate-300 hover:bg-slate-600'}`}
                  >
                    {showBulgingSurface ? 'Hide S₂ (bulging surface)' : 'Show S₂ (bulging surface)'}
                  </button>
                </div>

                {/* Live readouts */}
                <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
                  <Readout label="Conduction I_c" value={`${chargeCurrent.toFixed(2)} mA`} color="text-amber-300" />
                  <Readout label="Displacement I_d" value={`${displacementCurrent.toFixed(2)} mA`} color="text-pink-300" />
                  <Readout label="dΦ_E/dt" value={`${fmtSci(phiE_rate, 2)} V·m/s`} color="text-cyan-300" />
                  <Readout label="dE/dt" value={`${fmtSci(dEdt, 2)} V·m⁻¹·s⁻¹`} color="text-emerald-300" />
                </div>

                <div className="mt-4 p-3 bg-slate-800/60 rounded-lg text-slate-300 text-xs leading-relaxed">
                  <p className="font-semibold text-white mb-1">Key insight:</p>
                  Notice I_d = I_c always — the displacement current between the plates <em>equals</em> the conduction
                  current in the wires. This is Maxwell&apos;s fix: ∮B·dl = μ₀(I_c + ε₀ dΦ_E/dt). Choosing surface S₁
                  (cuts wire) or S₂ (bulges between plates) now gives the <em>same</em> magnetic field.
                </div>
              </motion.div>
            )}

            {/* ─── EM WAVES SIM (node 073) ─── */}
            {activeTopic === 'emwaves' && (
              <motion.div key="emw" initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}>
                <h2 className="text-white text-lg font-bold mb-1">EM Wave Propagation — E⊥B⊥c</h2>
                <p className="text-slate-400 text-xs mb-4">
                  Node {NODE_C12_PHY_073} · Self-propagating oscillating E and B fields at speed c = 1/√(μ₀ε₀).
                </p>

                <EMWaveCanvas
                  amplitude={waveAmplitude}
                  visualK={visualK}
                  time={waveTime}
                  showB={showBField}
                  direction={propagationDir}
                  playing={wavePlaying}
                />

                <div className="grid sm:grid-cols-2 gap-4 mt-4 mb-4">
                  <div className="bg-slate-800 rounded-lg p-3">
                    <label className="text-slate-300 text-xs block mb-1">
                      E₀ amplitude: <span className="text-emerald-300 font-mono">{waveAmplitude.toFixed(0)} V/m</span>
                    </label>
                    <input type="range" min={20} max={300} step={5} value={waveAmplitude}
                      onChange={(e) => { setWaveAmplitude(parseFloat(e.target.value)); handleInteraction(); }}
                      className="w-full accent-emerald-400" />
                  </div>
                  <div className="bg-slate-800 rounded-lg p-3">
                    <label className="text-slate-300 text-xs block mb-1">
                      Frequency: <span className="text-cyan-300 font-mono">{waveFrequency.toFixed(1)}×10¹⁴ Hz</span>
                    </label>
                    <input type="range" min={1} max={30} step={0.5} value={waveFrequency}
                      onChange={(e) => { setWaveFrequency(parseFloat(e.target.value)); handleInteraction(); }}
                      className="w-full accent-cyan-400" />
                  </div>
                </div>

                <div className="flex flex-wrap gap-2 mb-4">
                  <button onClick={() => { setWavePlaying((p) => !p); handleInteraction(); }}
                    className="px-4 py-2 rounded-lg bg-indigo-500 hover:bg-indigo-400 text-white text-sm font-semibold">
                    {wavePlaying ? '⏸ Pause' : '▶ Play'}
                  </button>
                  <button onClick={() => { setShowBField((s) => !s); handleInteraction(); }}
                    className={`px-4 py-2 rounded-lg text-sm font-semibold ${showBField ? 'bg-pink-500 text-white' : 'bg-slate-700 text-slate-300 hover:bg-slate-600'}`}>
                    {showBField ? 'Hide B field' : 'Show B field'}
                  </button>
                  <button onClick={() => { setPropagationDir((d) => (d === '+x' ? '-x' : '+x')); handleInteraction(); }}
                    className="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-300 text-sm font-semibold">
                    Direction: {propagationDir}
                  </button>
                </div>

                <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
                  <Readout label="Speed c" value={`${fmtSci(C_LIGHT, 3)} m/s`} color="text-amber-300" />
                  <Readout label="Wavelength λ" value={`${fmtSci(lambdaActual, 2)} m`} color="text-cyan-300" />
                  <Readout label="Frequency f" value={`${fmtSci(fActual, 2)} Hz`} color="text-emerald-300" />
                  <Readout label="B₀ = E₀/c" value={`${fmtSci(B0, 2)} T`} color="text-pink-300" />
                </div>

                <div className="mt-4 p-3 bg-slate-800/60 rounded-lg text-slate-300 text-xs leading-relaxed">
                  <p className="font-semibold text-white mb-1">Transverse nature:</p>
                  E (emerald, vertical) and B (pink, horizontal) are both perpendicular to propagation c (x-axis),
                  and perpendicular to each other: <span className="font-mono text-emerald-300">E ⊥ B ⊥ c</span>.
                  E×B points in the direction of propagation. Both fields are <em>in phase</em> and self-regenerate
                  through Maxwell&apos;s equations — no medium needed.
                </div>
              </motion.div>
            )}

            {/* ─── WAVE EQUATION SIM (node 074) ─── */}
            {activeTopic === 'waveeqn' && (
              <motion.div key="weqn" initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}>
                <h2 className="text-white text-lg font-bold mb-1">EM Wave Equation &amp; Transverse Nature</h2>
                <p className="text-slate-400 text-xs mb-4">
                  Node {NODE_C12_PHY_074} · ∇²E = (1/c²)∂²E/∂t² with c = 1/√(μ₀ε₀); E₀/B₀ = c.
                </p>

                {/* Equation display */}
                <div className="bg-slate-950 rounded-xl p-4 mb-4 font-mono text-sm text-slate-200 overflow-x-auto">
                  <div className="text-cyan-300 mb-2">From Maxwell&apos;s curl equations (free space):</div>
                  <div className="text-slate-300">∇×E = −∂B/∂t &nbsp;&nbsp; ∇×B = μ₀ε₀ ∂E/∂t</div>
                  <div className="text-slate-400 my-2">Take curl, use ∇×(∇×A) = ∇(∇·A) − ∇²A, with ∇·E = 0, ∇·B = 0:</div>
                  <div className="text-emerald-300 text-base">∇²E = (1/c²) ∂²E/∂t² &nbsp;&nbsp;&nbsp; ∇²B = (1/c²) ∂²B/∂t²</div>
                  <div className="text-slate-400 my-2">Match with general wave eqn ∇²ψ = (1/v²) ∂²ψ/∂t² →</div>
                  <div className="text-amber-300 text-base">c = 1/√(μ₀ε₀) ≈ {fmtSci(C_LIGHT, 3)} m/s</div>
                  <div className="text-slate-400 my-2">Sinusoidal solutions (in phase, E⊥B⊥c):</div>
                  <div className="text-pink-300">E = E₀ sin(kx − ωt) ĵ &nbsp;&nbsp; B = B₀ sin(kx − ωt) k̂</div>
                  <div className="text-slate-400 my-2">Amplitude relation (from ∇×E = −∂B/∂t):</div>
                  <div className="text-emerald-300 text-base">E₀/B₀ = c &nbsp;⇒&nbsp; B₀ = E₀/c</div>
                </div>

                {/* Interactive: vary E₀, see B₀ and c */}
                <div className="bg-slate-800 rounded-lg p-3 mb-3">
                  <label className="text-slate-300 text-xs block mb-1">
                    E₀: <span className="text-emerald-300 font-mono">{waveAmplitude.toFixed(0)} V/m</span>
                  </label>
                  <input type="range" min={10} max={500} step={5} value={waveAmplitude}
                    onChange={(e) => { setWaveAmplitude(parseFloat(e.target.value)); handleInteraction(); }}
                    className="w-full accent-emerald-400" />
                </div>

                <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
                  <Readout label="E₀" value={`${waveAmplitude.toFixed(1)} V/m`} color="text-emerald-300" />
                  <Readout label="B₀ = E₀/c" value={`${fmtSci(waveAmplitude / C_LIGHT, 2)} T`} color="text-pink-300" />
                  <Readout label="c = 1/√(μ₀ε₀)" value={`${fmtSci(C_LIGHT, 3)} m/s`} color="text-amber-300" />
                  <Readout label="μ₀ε₀" value={`${fmtSci(MU_0 * EPS_0, 3)} s²/m²`} color="text-cyan-300" />
                </div>

                {/* Snapshot diagram with labelled axes */}
                <div className="bg-slate-950 rounded-xl p-4 mt-4">
                  <svg viewBox="0 0 600 240" className="w-full h-auto" style={{ maxWidth: 600 }}>
                    {/* axes */}
                    <line x1="40" y1="120" x2="560" y2="120" stroke="#64748B" strokeWidth="1.5" />
                    <line x1="40" y1="20" x2="40" y2="220" stroke="#64748B" strokeWidth="1.5" />
                    <text x="565" y="125" fill="#94A3B8" fontSize="11">x (c)</text>
                    <text x="20" y="18" fill="#94A3B8" fontSize="11">y (E)</text>
                    <text x="300" y="14" fill="#94A3B8" fontSize="11">z (B) — out of page</text>
                    {/* E wave (vertical) */}
                    {Array.from({ length: 80 }).map((_, i) => {
                      const x = 50 + i * 6.5;
                      const phase = visualK * (x - 50) - (wavePlaying ? waveTime * 3 : 0);
                      const ey = Math.sin(phase) * (waveAmplitude / 300) * 80;
                      return <line key={`e${i}`} x1={x} y1={120} x2={x} y2={120 - ey} stroke="#34D399" strokeWidth="2" opacity={0.85} />;
                    })}
                    {/* B wave (horizontal, represented as ellipse widths) */}
                    {showBField && Array.from({ length: 40 }).map((_, i) => {
                      const x = 55 + i * 13;
                      const phase = visualK * (x - 50) - (wavePlaying ? waveTime * 3 : 0);
                      const bx = Math.sin(phase) * 18;
                      return <ellipse key={`b${i}`} cx={x} cy={120} rx={Math.abs(bx)} ry={4} fill="rgba(244,114,182,0.4)" stroke="#F472B6" strokeWidth="1" />;
                    })}
                    {/* labels */}
                    <text x="60" y="40" fill="#34D399" fontSize="12" fontWeight="bold">E (y)</text>
                    {showBField && <text x="60" y="210" fill="#F472B6" fontSize="12" fontWeight="bold">B (z)</text>}
                    <text x="500" y="140" fill="#FBBF24" fontSize="12" fontWeight="bold">c →</text>
                  </svg>
                  <p className="text-slate-400 text-xs mt-2">
                    Both fields share the same argument (kx − ωt) → <span className="text-emerald-300">in phase</span>.
                    E along y, B along z, propagation along x: <span className="text-amber-300">E ⊥ B ⊥ c</span>.
                  </p>
                </div>
              </motion.div>
            )}

            {/* ─── EM SPECTRUM SIM (node 075) ─── */}
            {activeTopic === 'spectrum' && (
              <motion.div key="spec" initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}>
                <h2 className="text-white text-lg font-bold mb-1">Electromagnetic Spectrum Explorer</h2>
                <p className="text-slate-400 text-xs mb-4">
                  Node {NODE_C12_PHY_075} · Radio → Microwave → IR → Visible → UV → X-ray → Gamma. All travel at c.
                </p>

                {/* Spectrum bar */}
                <div className="bg-slate-950 rounded-xl p-4 mb-4">
                  <div className="flex h-16 rounded-lg overflow-hidden">
                    {SPECTRUM_BANDS.map((b, i) => (
                      <button
                        key={b.name}
                        onClick={() => { setSelectedBand(i); handleInteraction(); }}
                        style={{ backgroundColor: b.color, flex: 1 }}
                        className={`flex flex-col items-center justify-center text-[10px] sm:text-xs font-bold transition-all ${
                          selectedBand === i ? 'ring-2 ring-white scale-105 z-10' : 'opacity-80 hover:opacity-100'
                        } ${b.name === 'Visible' ? 'text-slate-900' : 'text-white'}`}
                        title={b.name}
                      >
                        <span className="text-base">{b.emoji}</span>
                        <span>{b.name}</span>
                      </button>
                    ))}
                  </div>
                  <div className="flex justify-between text-[10px] text-slate-400 mt-1">
                    <span>← long λ / low f</span>
                    <span>short λ / high f →</span>
                  </div>
                </div>

                {/* Selected band details */}
                <div className="bg-slate-800 rounded-xl p-4 mb-4">
                  <div className="flex items-center gap-2 mb-2">
                    <span className="text-2xl">{SPECTRUM_BANDS[selectedBand].emoji}</span>
                    <h3 className="text-white font-bold text-lg">{SPECTRUM_BANDS[selectedBand].name} Waves</h3>
                  </div>
                  <div className="grid sm:grid-cols-2 gap-3 text-xs">
                    <DetailRow label="Wavelength range" value={`${fmtSci(SPECTRUM_BANDS[selectedBand].lambdaMin, 1)} – ${fmtSci(SPECTRUM_BANDS[selectedBand].lambdaMax, 1)} m`} />
                    <DetailRow label="Frequency range" value={`${fmtSci(SPECTRUM_BANDS[selectedBand].freqMin, 1)} – ${fmtSci(SPECTRUM_BANDS[selectedBand].freqMax, 1)} Hz`} />
                    <DetailRow label="Source" value={SPECTRUM_BANDS[selectedBand].source} />
                    <DetailRow label="Detector" value={SPECTRUM_BANDS[selectedBand].detector} />
                    <DetailRow label="Uses" value={SPECTRUM_BANDS[selectedBand].uses} />
                    <DetailRow label="Speed in vacuum" value={`${fmtSci(C_LIGHT, 3)} m/s (same for all)`} />
                  </div>
                </div>

                {/* Wavelength → frequency calculator */}
                <div className="bg-slate-800 rounded-xl p-4 mb-4">
                  <h4 className="text-white text-sm font-semibold mb-2">λ → f Calculator (c = fλ)</h4>
                  <div className="flex flex-wrap gap-2 items-end mb-3">
                    <div className="flex-1 min-w-[120px]">
                      <label className="text-slate-400 text-xs block mb-1">Wavelength</label>
                      <input
                        type="number" value={spectrumLambdaInput}
                        onChange={(e) => { setSpectrumLambdaInput(parseFloat(e.target.value) || 0); handleInteraction(); }}
                        className="w-full bg-slate-900 text-white text-sm rounded px-2 py-1 border border-slate-700"
                      />
                    </div>
                    <div>
                      <label className="text-slate-400 text-xs block mb-1">Unit</label>
                      <select
                        value={spectrumUnit}
                        onChange={(e) => { setSpectrumUnit(e.target.value as typeof spectrumUnit); handleInteraction(); }}
                        className="bg-slate-900 text-white text-sm rounded px-2 py-1 border border-slate-700"
                      >
                        <option value="nm">nm</option>
                        <option value="um">µm</option>
                        <option value="mm">mm</option>
                        <option value="m">m</option>
                        <option value="angstrom">Å</option>
                      </select>
                    </div>
                  </div>
                  <div className="grid grid-cols-2 sm:grid-cols-3 gap-3">
                    <Readout label="λ (m)" value={`${fmtSci(lambdaInMetres, 2)} m`} color="text-cyan-300" />
                    <Readout label="f = c/λ" value={`${fmtSci(freqFromLambda, 2)} Hz`} color="text-emerald-300" />
                    <Readout
                      label="Spectrum region"
                      value={bandForLambda >= 0 ? SPECTRUM_BANDS[bandForLambda].name : 'out of range'}
                      color="text-amber-300"
                    />
                  </div>
                  {bandForLambda < 0 && (
                    <p className="text-rose-300 text-xs mt-2">
                      ⚠ That wavelength is outside the listed bands. Check your unit conversion (nm → m means ×10⁻⁹).
                    </p>
                  )}
                </div>

                <div className="p-3 bg-slate-800/60 rounded-lg text-slate-300 text-xs leading-relaxed">
                  <p className="font-semibold text-white mb-1">Remember the order (increasing frequency):</p>
                  Radio → TV → Microwave → Infrared → Visible → Ultraviolet → X-ray → Gamma.
                  All travel at c = 3×10⁸ m/s in vacuum; they differ only in λ and f. Distinguish
                  <span className="text-emerald-300"> properties</span> (transverse, no medium, speed c) from
                  <span className="text-amber-300"> uses</span> (cooking, radar, imaging).
                </div>
              </motion.div>
            )}
          </AnimatePresence>
        </div>
      </div>

      {/* ─── Progressive Challenges ────────────────────────────────────────── */}
      {!challengeCompleted ? (
        <div className="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 mb-8">
          <div className="flex items-center justify-between mb-4">
            <h2 className="text-lg font-bold text-slate-900">
              Challenge {currentChallengeIdx + 1} / {diagnosticQuestions.length}
              <span className="ml-2 text-xs font-normal text-slate-500">
                ({activeQuestion?.bloomLevel}) · {difficultyLevel}
              </span>
            </h2>
            <div className="flex items-center gap-2">
              <span className="text-xs text-slate-500">Score: <span className="font-bold text-indigo-600">{score}</span></span>
              <span className="text-xs text-slate-500">Errors: <span className="font-bold text-rose-500">{errors}</span></span>
            </div>
          </div>

          {/* Progress dots */}
          <div className="flex gap-1 mb-4">
            {diagnosticQuestions.map((_, i) => (
              <div key={i} className={`h-1.5 flex-1 rounded-full ${i < currentChallengeIdx ? 'bg-emerald-500' : i === currentChallengeIdx ? 'bg-indigo-500' : 'bg-slate-200'}`} />
            ))}
          </div>

          <div className="p-4 bg-slate-50 rounded-xl mb-4">
            <p className="text-slate-800 text-sm leading-relaxed">{activeQuestion?.question}</p>
            {activeQuestion?.formula && (
              <p className="mt-2 text-xs text-indigo-600 font-mono">Formula: {activeQuestion.formula}</p>
            )}
          </div>

          {/* Answer input */}
          {activeQuestion?.answerType === 'mcq' ? (
            <div className="grid sm:grid-cols-2 gap-2 mb-4">
              {activeQuestion.options?.map((opt) => (
                <button
                  key={opt}
                  onClick={() => { setStudentAnswer(opt); handleInteraction(); }}
                  className={`px-4 py-3 rounded-lg text-sm font-medium border-2 transition-all ${
                    studentAnswer === opt ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-white text-slate-700 border-slate-200 hover:border-indigo-300'
                  }`}
                >
                  {opt}
                </button>
              ))}
            </div>
          ) : (
            <div className="mb-4">
              <input
                type="text"
                value={studentAnswer}
                onChange={(e) => { setStudentAnswer(e.target.value); handleInteraction(); }}
                placeholder={activeQuestion?.unit ? `Enter answer (${activeQuestion.unit})…` : 'Enter your answer…'}
                className="w-full px-4 py-3 rounded-lg border-2 border-slate-200 focus:border-indigo-500 focus:outline-none text-sm"
              />
            </div>
          )}

          {/* Guided sub-steps (after 2 wrong) */}
          {guidedSubStep > 0 && challengeFeedback.status === 'wrong' && (
            <motion.div initial={{ opacity: 0, y: 5 }} animate={{ opacity: 1, y: 0 }} className="p-4 bg-amber-50 border border-amber-200 rounded-xl mb-4 text-sm">
              <p className="font-semibold text-amber-900 mb-2">Let&apos;s break this down step-by-step:</p>
              <ol className="list-decimal list-inside space-y-1 text-amber-800 text-xs">
                <li>Identify the given quantities and the target variable.</li>
                <li>Write down the relevant formula (see the Formula line above).</li>
                <li>Convert all units to SI (e.g. mA → A = ×10⁻³, nm → m = ×10⁻⁹).</li>
                <li>Substitute and compute. Express in scientific notation if very large/small.</li>
                <li>Check the direction/units of the final answer.</li>
              </ol>
            </motion.div>
          )}

          {/* Feedback */}
          {challengeFeedback.status !== 'idle' && (
            <motion.div
              initial={{ opacity: 0, y: 5 }}
              animate={{ opacity: 1, y: 0 }}
              className={`p-4 rounded-xl mb-4 text-sm ${
                challengeFeedback.status === 'correct'
                  ? 'bg-emerald-50 border border-emerald-200 text-emerald-900'
                  : 'bg-rose-50 border border-rose-200 text-rose-900'
              }`}
            >
              <p className="font-semibold mb-1">
                {challengeFeedback.status === 'correct' ? '✓ Correct!' : '✗ Not quite — try the variant or use the hint.'}
              </p>
              <p className="text-xs">{challengeFeedback.message}</p>
              {challengeFeedback.working && (
                <details className="mt-2">
                  <summary className="text-xs font-semibold cursor-pointer">Show worked solution</summary>
                  <pre className="text-xs mt-1 whitespace-pre-wrap font-mono">{challengeFeedback.working}</pre>
                </details>
              )}
            </motion.div>
          )}

          {/* Hint button */}
          {showHintButton && hintLevel === 0 && challengeFeedback.status === 'idle' && (
            <button onClick={handleShowHint} className="mb-3 px-4 py-2 rounded-lg bg-blue-100 text-blue-700 text-sm font-semibold hover:bg-blue-200">
              💡 Show Hint
            </button>
          )}
          {hintLevel > 0 && activeQuestion?.hint && (
            <div className="p-3 bg-blue-50 border border-blue-200 rounded-lg mb-3 text-xs text-blue-900">
              <span className="font-semibold">Hint (level {hintLevel}):</span> {activeQuestion.hint}
            </div>
          )}

          {/* Action buttons */}
          <div className="flex flex-wrap gap-2">
            {challengeFeedback.status === 'idle' && (
              <button
                onClick={handleSubmitAnswer}
                disabled={!studentAnswer.trim()}
                className="px-5 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 disabled:opacity-40 text-white text-sm font-semibold"
              >
                Submit Answer
              </button>
            )}
            {challengeFeedback.status === 'wrong' && (
              <button onClick={handleRetryVariant} className="px-5 py-2 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-900 text-sm font-semibold">
                Try a Different Variant
              </button>
            )}
            {challengeFeedback.status === 'correct' && (
              <button onClick={handleNextChallenge} className="px-5 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold">
                {currentChallengeIdx < diagnosticQuestions.length - 1 ? 'Next Challenge →' : 'Finish 🎉'}
              </button>
            )}
            {hintLevel < 3 && challengeFeedback.status !== 'correct' && (
              <button onClick={handleShowHint} className="px-4 py-2 rounded-lg bg-slate-100 text-slate-600 text-sm font-semibold hover:bg-slate-200">
                💡 Hint ({hintLevel}/3)
              </button>
            )}
          </div>
        </div>
      ) : (
        <motion.div initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} className="bg-white rounded-2xl shadow-lg border border-emerald-200 p-8 mb-8 text-center">
          <h2 className="text-2xl font-bold text-emerald-700 mb-2">🎉 Mastery Challenge Complete!</h2>
          <p className="text-slate-600 mb-4">You finished all {diagnosticQuestions.length} challenges on Electromagnetic Waves.</p>
          <div className="text-4xl font-bold text-indigo-600 mb-2">{score} / 100</div>
          <p className="text-sm text-slate-500 mb-4">Errors: {errors} · Final difficulty: {difficultyLevel}</p>
          <div className="grid sm:grid-cols-4 gap-2 mb-4">
            {ALL_NODE_IDS.map((id) => {
              const m = getMasteryLevel(bktStates[id]?.pKnown ?? 0);
              return (
                <div key={id} className="p-2 bg-slate-50 rounded-lg text-xs">
                  <div className="font-mono text-slate-500">{id}</div>
                  <div className="font-semibold text-indigo-600">{m}</div>
                  <div className="text-slate-400">{((bktStates[id]?.pKnown ?? 0) * 100).toFixed(0)}%</div>
                </div>
              );
            })}
          </div>
          <button
            onClick={() => {
              setChallengeCompleted(false);
              setCurrentChallengeIdx(0);
              setScore(0);
              setErrors(0);
              setRetryCount(0);
              setStudentAnswer('');
              setChallengeFeedback({ status: 'idle', message: '' });
            }}
            className="px-5 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold"
          >
            ↻ Retry All Challenges
          </button>
        </motion.div>
      )}

      {/* ─── Real-world activity ──────────────────────────────────────────── */}
      <div className="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 mb-8">
        <h2 className="text-lg font-bold text-slate-900 mb-2">🔬 Real-World Activity</h2>
        <p className="text-sm text-slate-600 mb-3">
          Design a short demonstration (apparatus, procedure, expected observation, safety) that would convince a
          sceptical Class 11 student that a magnetic field really exists around the gap of a charging capacitor,
          even though no charge crosses the gap. Use a search coil, galvanometer/CRO, electrolytic capacitor, and
          a current-limiting resistor. Write your plan below.
        </p>
        <textarea
          value={activityText}
          onChange={(e) => { setActivityText(e.target.value); handleInteraction(); }}
          placeholder="Apparatus: …&#10;Procedure: …&#10;Expected observation: …&#10;Safety precautions: …"
          rows={6}
          className="w-full px-4 py-3 rounded-lg border-2 border-slate-200 focus:border-indigo-500 focus:outline-none text-sm font-mono"
        />
        <div className="flex items-center gap-3 mt-3">
          <button
            onClick={handleActivitySubmit}
            disabled={!activityText.trim()}
            className="px-5 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 disabled:opacity-40 text-white text-sm font-semibold"
          >
            Submit Activity
          </button>
          {activitySubmitted && (
            <span className="text-emerald-600 text-sm font-semibold">
              ✓ Recorded! {activityText.trim().length > 100 ? 'Excellent detail.' : 'Try adding more detail about the search coil and safety.'}
            </span>
          )}
        </div>
      </div>

      {/* ─── Footer: node map & mastery summary ───────────────────────────── */}
      <div className="bg-slate-100 rounded-xl p-4 text-xs text-slate-500">
        <p className="font-semibold text-slate-700 mb-2">Nodes covered in this simulation:</p>
        <div className="grid sm:grid-cols-2 gap-2">
          {[
            { id: NODE_C12_PHY_072, label: 'Displacement current' },
            { id: NODE_C12_PHY_073, label: 'EM waves (properties, speed)' },
            { id: NODE_C12_PHY_074, label: 'EM wave equation & transverse nature' },
            { id: NODE_C12_PHY_075, label: 'Electromagnetic spectrum' },
          ].map((n) => {
            const m = getMasteryLevel(bktStates[n.id]?.pKnown ?? 0);
            const pct = ((bktStates[n.id]?.pKnown ?? 0) * 100).toFixed(0);
            return (
              <div key={n.id} className="flex items-center justify-between bg-white rounded-lg px-3 py-2 border border-slate-200">
                <div>
                  <span className="font-mono text-slate-600">{n.id}</span>
                  <span className="ml-2 text-slate-700">{n.label}</span>
                </div>
                <div className="text-right">
                  <span className="font-semibold text-indigo-600">{m}</span>
                  <span className="ml-2 text-slate-400">{pct}%</span>
                </div>
              </div>
            );
          })}
        </div>
        <p className="mt-3 text-slate-400">
          Mastery persists via BKT + SM-2 spaced repetition in localStorage. Score saved with recordGameScore().
        </p>
      </div>
    </div>
  );
}

// ═══════════════════════════════════════════════════════════════════════════
// Sub-components
// ═══════════════════════════════════════════════════════════════════════════

interface TopicToNode { displacement: string; emwaves: string; waveeqn: string; spectrum: string; }

function Readout({ label, value, color }: { label: string; value: string; color: string }) {
  return (
    <div className="bg-slate-800/60 rounded-lg p-2 border border-slate-700">
      <div className="text-[10px] text-slate-400 uppercase tracking-wider">{label}</div>
      <div className={`text-sm font-mono font-semibold ${color}`}>{value}</div>
    </div>
  );
}

function DetailRow({ label, value }: { label: string; value: string }) {
  return (
    <div>
      <div className="text-slate-400 uppercase tracking-wider text-[10px]">{label}</div>
      <div className="text-slate-100 text-xs mt-0.5">{value}</div>
    </div>
  );
}

// ─── EM Wave Canvas (animated E & B fields) ─────────────────────────────────
function EMWaveCanvas({
  amplitude,
  visualK,
  time,
  showB,
  direction,
  playing,
}: {
  amplitude: number;
  visualK: number;
  time: number;
  showB: boolean;
  direction: '+x' | '-x';
  playing: boolean;
}) {
  const canvasRef = useRef<HTMLCanvasElement | null>(null);

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const W = canvas.width;
    const H = canvas.height;
    ctx.clearRect(0, 0, W, H);

    // Background
    ctx.fillStyle = '#020617';
    ctx.fillRect(0, 0, W, H);

    // Axes
    const cx = W / 2;
    const cy = H / 2;
    ctx.strokeStyle = '#475569';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(0, cy);
    ctx.lineTo(W, cy);
    ctx.moveTo(cx, 0);
    ctx.lineTo(cx, H);
    ctx.stroke();

    // Axis labels
    ctx.fillStyle = '#94A3B8';
    ctx.font = '11px sans-serif';
    ctx.fillText('x (propagation c)', W - 110, cy - 6);
    ctx.fillText('y (E)', cx + 6, 14);
    ctx.fillText('z (B)', cx + 6, H - 14);

    const t = playing ? time * 4 : 0;
    const dirSign = direction === '+x' ? 1 : -1;
    const ampScale = (amplitude / 300) * 90;

    // E field (vertical, emerald)
    ctx.strokeStyle = '#34D399';
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    for (let px = 0; px <= W; px += 2) {
      const phase = visualK * (px - cx) * dirSign - t;
      const ey = Math.sin(phase) * ampScale;
      if (px === 0) ctx.moveTo(px, cy - ey);
      else ctx.lineTo(px, cy - ey);
    }
    ctx.stroke();

    // E field arrows (sampled)
    ctx.fillStyle = '#34D399';
    for (let px = 20; px < W; px += 40) {
      const phase = visualK * (px - cx) * dirSign - t;
      const ey = Math.sin(phase) * ampScale;
      drawArrow(ctx, px, cy, px, cy - ey, '#34D399');
    }

    // B field (horizontal, pink) — drawn as ellipses to suggest "out of page"
    if (showB) {
      ctx.strokeStyle = '#F472B6';
      ctx.lineWidth = 2;
      for (let px = 20; px < W; px += 20) {
        const phase = visualK * (px - cx) * dirSign - t;
        const bx = Math.sin(phase) * 22;
        ctx.beginPath();
        ctx.ellipse(px, cy, Math.abs(bx), 5, 0, 0, Math.PI * 2);
        ctx.stroke();
        // dot/cross to indicate direction
        if (bx > 0) {
          ctx.fillStyle = '#F472B6';
          ctx.beginPath();
          ctx.arc(px, cy, 1.5, 0, Math.PI * 2);
          ctx.fill();
        } else {
          ctx.strokeStyle = '#F472B6';
          ctx.beginPath();
          ctx.moveTo(px - 3, cy - 3);
          ctx.lineTo(px + 3, cy + 3);
          ctx.moveTo(px + 3, cy - 3);
          ctx.lineTo(px - 3, cy + 3);
          ctx.stroke();
        }
      }
    }

    // Propagation arrow
    ctx.fillStyle = '#FBBF24';
    ctx.font = 'bold 13px sans-serif';
    const arrowX = direction === '+x' ? W - 30 : 30;
    ctx.fillText(`c ${direction}`, arrowX - 20, cy + 80);

    // Legend
    ctx.fillStyle = '#34D399';
    ctx.fillRect(10, 10, 12, 12);
    ctx.fillStyle = '#F472B6';
    ctx.fillRect(10, 28, 12, 12);
    ctx.fillStyle = '#FBBF24';
    ctx.fillRect(10, 46, 12, 12);
    ctx.fillStyle = '#CBD5E1';
    ctx.font = '11px sans-serif';
    ctx.fillText('E field (y)', 28, 20);
    ctx.fillText('B field (z)', 28, 38);
    ctx.fillText('propagation c', 28, 56);
  }, [amplitude, visualK, time, showB, direction, playing]);

  return (
    <div className="bg-slate-950 rounded-xl p-2 overflow-hidden">
      <canvas ref={canvasRef} width={640} height={260} className="w-full h-auto" style={{ maxWidth: 640 }} />
    </div>
  );
}

function drawArrow(
  ctx: CanvasRenderingContext2D,
  x1: number,
  y1: number,
  x2: number,
  y2: number,
  color: string,
) {
  ctx.strokeStyle = color;
  ctx.fillStyle = color;
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.moveTo(x1, y1);
  ctx.lineTo(x2, y2);
  ctx.stroke();
  // arrowhead
  const angle = Math.atan2(y2 - y1, x2 - x1);
  const headLen = 6;
  ctx.beginPath();
  ctx.moveTo(x2, y2);
  ctx.lineTo(x2 - headLen * Math.cos(angle - Math.PI / 6), y2 - headLen * Math.sin(angle - Math.PI / 6));
  ctx.lineTo(x2 - headLen * Math.cos(angle + Math.PI / 6), y2 - headLen * Math.sin(angle + Math.PI / 6));
  ctx.closePath();
  ctx.fill();
}
