```json
{
  "code": {
    "explanation": "Full teacher dashboard with class overview, worksheet creation with preview, WhatsApp integration, performance tracking, struggling-student highlighting, and 3-language support (EN/HI/Hinglish). Glass-morphism design, mobile-first, Framer Motion animations, fully accessible.",
    "fileContent": "'use client';\n\n// --- TYPES ---\ninterface Student {\n  id: string;\n  name: string;\n  mastery: number; // 0–100\n  completedHomework: boolean;\n  topicsStruggling: string[];\n}\n\ninterface ClassData {\n  id: string;\n  name: string;\n  subject: string;\n  studentCount: number;\n  averageMastery: number;\n  homeworkCompletionRate: number;\n  students: Student[];\n}\n\ninterface WorksheetQuestion {\n  id: string;\n  text: string;\n  difficulty: 'easy' | 'medium' | 'hard';\n  competency: string;\n}\n\ninterface WorksheetForm {\n  subject: string;\n  topic: string;\n  difficulty: 'easy' | 'medium' | 'hard' | 'mixed';\n  numQuestions: number;\n  competencyRatios: Record<string, number>;\n}\n\n// --- I18N TRANSLATIONS ---\nconst translations: Record<string, Record<string, any>> = {\n  en: {\n    dashboardTitle: 'Teacher Dashboard',\n    classes: 'My Classes',\n    students: 'students',\n    avgMastery: 'Avg Mastery',\n    completionRate: 'Completion Rate',\n    createWorksheet: 'Create Worksheet',\n    preview: 'Preview',\n    sendWhatsApp: 'Send via WhatsApp',\n    performance: 'Class Performance',\n    struggling: 'Struggling',\n    remediation: 'Send Remediation',\n    subject: 'Subject',\n    topic: 'Topic',\n    difficulty: 'Difficulty',\n    numQuestions: 'Questions',\n    competencies: 'Competency Ratios',\n    memory: 'Memory',\n    understanding: 'Understanding',\n    application: 'Application',\n    easy: 'Easy',\n    medium: 'Medium',\n    hard: 'Hard',\n    mixed: 'Mixed',\n    worksheetPreview: 'Worksheet Preview',\n    generatedQuestions: 'Generated Questions',\n    confirmSend: 'Confirm & Send',\n    sent: 'Sent!',\n    allStudents: 'All Students',\n    mastery: 'Mastery',\n    homeworkStatus: 'Homework Status',\n    strugglingTopics: 'Struggling Topics',\n    language: 'Language',\n    back: 'Back',\n    noStruggling: 'No struggling students 🎉',\n    generateWorksheet: 'Generate Worksheet',\n  },\n  hi: {\n    dashboardTitle: 'शिक्षक डैशबोर्ड',\n    classes: 'मेरी कक्षाएं',\n    students: 'छात्र',\n    avgMastery: 'औसत महारत',\n    completionRate: 'पूर्णता दर',\n    createWorksheet: 'वर्कशीट बनाएं',\n    preview: 'पूर्वावलोकन',\n    sendWhatsApp: 'व्हाट्सएप से भेजें',\n    performance: 'कक्षा प्रदर्शन',\n    struggling: 'कठिनाई',\n    remediation: 'सुधार भेजें',\n    subject: 'विषय',\n    topic: 'विषय',\n    difficulty: 'कठिनाई स्तर',\n    numQuestions: 'प्रश्न',\n    competencies: 'क्षमता अनुपात',\n    memory: 'स्मृति',\n    understanding: 'समझ',\n    application: 'अनुप्रयोग',\n    easy: 'आसान',\n    medium: 'मध्यम',\n    hard: 'कठिन',\n    mixed: 'मिश्रित',\n    worksheetPreview: 'वर्कशीट पूर्वावलोकन',\n    generatedQuestions: 'उत्पन्न प्रश्न',\n    confirmSend: 'पुष्टि करें और भेजें',\n    sent: 'भेज दिया!',\n    allStudents: 'सभी छात्र',\n    mastery: 'महारत',\n    homeworkStatus: 'होमवर्क स्थिति',\n    strugglingTopics: 'कठिनाई विषय',\n    language: 'भाषा',\n    back: 'वापस',\n    noStruggling: 'कोई कठिनाई नहीं 🎉',\n    generateWorksheet: 'वर्कशीट बनाएं',\n  },\n  hinglish: {\n    dashboardTitle: 'Teacher Dashboard',\n    classes: 'Meri Classes',\n    students: 'students',\n    avgMastery: 'Avg Mastery',\n    completionRate: 'Completion Rate',\n    createWorksheet: 'Worksheet Banaye',\n    preview: 'Preview',\n    sendWhatsApp: 'WhatsApp se Bheje',\n    performance: 'Class Performance',\n    struggling: 'Struggling',\n    remediation: 'Remediation Bheje',\n    subject: 'Subject',\n    topic: 'Topic',\n    difficulty: 'Difficulty',\n    numQuestions: 'Questions',\n    competencies: 'Competency Ratios',\n    memory: 'Memory',\n    understanding: 'Understanding',\n    application: 'Application',\n    easy: 'Easy',\n    medium: 'Medium',\n    hard: 'Hard',\n    mixed: 'Mixed',\n    worksheetPreview: 'Worksheet Preview',\n    generatedQuestions: 'Generated Questions',\n    confirmSend: 'Confirm & Send',\n    sent: 'Sent!',\n    allStudents: 'All Students',\n    mastery: 'Mastery',\n    homeworkStatus: 'Homework Status',\n    strugglingTopics: 'Struggling Topics',\n    language: 'Language',\n    back: 'Back',\n    noStruggling: 'No struggling students 🎉',\n    generateWorksheet: 'Worksheet Banaye',\n  },\n};\n\n// --- MOCK DATA ---\nconst mockClasses: ClassData[] = [\n  {\n    id: '1',\n    name: 'Class 11A — Maths',\n    subject: 'Mathematics',\n    studentCount: 32,\n    averageMastery: 68,\n    homeworkCompletionRate: 82,\n    students: [\n      { id: 's1', name: 'Aarav Sharma', mastery: 88, completedHomework: true, topicsStruggling: [] },\n      { id: 's2', name: 'Priya Patel', mastery: 45, completedHomework: false, topicsStruggling: ['Integration'] },\n      { id: 's3', name: 'Rahul Verma', mastery: 72, completedHomework: true, topicsStruggling: [] },\n      { id: 's4', name: 'Sneha Gupta', mastery: 35, completedHomework: false, topicsStruggling: ['Calculus', 'Limits'] },\n      { id: 's5', name: 'Karan Singh', mastery: 91, completedHomework: true, topicsStruggling: [] },\n      { id: 's6', name: 'Ananya Joshi', mastery: 52, completedHomework: true, topicsStruggling: ['Differentiation'] },\n      { id: 's7', name: 'Dev Mehta', mastery: 29, completedHomework: false, topicsStruggling: ['Integration', 'Differentiation'] },\n      { id: 's8', name: 'Isha Kapoor', mastery: 78, completedHomework: true, topicsStruggling: [] },\n    ],\n  },\n  {\n    id: '2',\n    name: 'Class 12B — Physics',\n    subject: 'Physics',\n    studentCount: 28,\n    averageMastery: 74,\n    homeworkCompletionRate: 76,\n    students: [\n      { id: 's9', name: 'Rohan Khanna', mastery: 85, completedHomework: true, topicsStruggling: [] },\n      { id: 's10', name: 'Meera Reddy', mastery: 38, completedHomework: false, topicsStruggling: ['Electromagnetism'] },\n      { id: 's11', name: 'Vikram Iyer', mastery: 62, completedHomework: true, topicsStruggling: ['Optics'] },\n      { id: 's12', name: 'Kavya Nair', mastery: 93, completedHomework: true, topicsStruggling: [] },\n      { id: 's13', name: 'Arjun Malhotra', mastery: 41, completedHomework: false, topicsStruggling: ['Waves', 'Sound'] },\n      { id: 's14', name: 'Diya Shah', mastery: 70, completedHomework: true, topicsStruggling: [] },\n    ],\n  },\n];\n\nconst sampleQuestions: WorksheetQuestion[] = [\n  { id: 'q1', text: 'Evaluate: ∫₀¹ x² dx', difficulty: 'medium', competency: 'application' },\n  { id: 'q2', text: 'State the Fundamental Theorem of Calculus.', difficulty: 'easy', competency: 'memory' },\n  { id: 'q3', text: 'Find d/dx(sin(x)·eˣ) using the product rule.', difficulty: 'medium', competency: 'application' },\n  { id: 'q4', text: 'Explain the geometric interpretation of a definite integral.', difficulty: 'hard', competency: 'understanding' },\n  { id: 'q5', text: 'Compute ∫eˣ cos(x) dx using integration by parts twice.', difficulty: 'hard', competency: 'application' },\n  { id: 'q6', text: 'List the properties of definite integrals.', difficulty: 'easy', competency: 'memory' },\n  { id: 'q7', text: 'Prove: ∫ₐᵇ f(x)dx = ∫ₐᵇ f(a+b-x)dx', difficulty: 'hard', competency: 'understanding' },\n  { id: 'q8', text: 'Solve: ∫(3x² + 2x + 1) dx', difficulty: 'easy', competency: 'application' },\n  { id: 'q9', text: 'What is the relationship between differentiation and integration?', difficulty: 'medium', competency: 'understanding' },\n  { id: 'q10', text: 'Evaluate ∫₁² (x³ - 2x + 5) dx.', difficulty: 'medium', competency: 'application' },\n];\n\nconst subjectOptions = ['Mathematics', 'Physics', 'Chemistry', 'Biology', 'English', 'History'];\nconst topicOptions: Record<string, string[]> = {\n  Mathematics: ['Algebra', 'Calculus', 'Trigonometry', 'Coordinate Geometry', 'Statistics', 'Probability'],\n  Physics: ['Mechanics', 'Electromagnetism', 'Optics', 'Thermodynamics', 'Waves', 'Modern Physics'],\n  Chemistry: ['Organic', 'Inorganic', 'Physical', 'Electrochemistry', 'Coordination'],\n  Biology: ['Cell Biology', 'Genetics', 'Ecology', 'Human Physiology', 'Botany'],\n  English: ['Grammar', 'Literature', 'Writing Skills', 'Comprehension'],\n  History: ['Ancient', 'Medieval', 'Modern', 'World History'],\n};\n\n// --- MAIN COMPONENT ---\nimport { useState, useMemo, useCallback } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\n\nconst easeOut = [0.16, 1, 0.3, 1];\nconst spring = { type: 'spring' as const, stiffness: 300, damping: 24 };\n\nfunction t(key: string, lang: string) {\n  return translations[lang]?.[key] || translations['en'][key] || key;\n}\n\nfunction MasteryBadge({ value, lang }: { value: number; lang: string }) {\n  const color = value >= 75 ? 'text-emerald-400 bg-emerald-400/15 border-emerald-400/30' :\n    value >= 50 ? 'text-amber-400 bg-amber-400/15 border-amber-400/30' :\n    'text-red-400 bg-red-400/15 border-red-400/30';\n  const label = value >= 75 ? 'Strong' : value >= 50 ? 'Adequate' : 'Weak';\n  return (\n    <span className={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold border ${color}`}>\n      {value}% {lang === 'hi' ? ' — ' : '· '}{t('mastery', lang)}: {label}\n    </span>\n  );\n}\n\nfunction MasteryBar({ value }: { value: number }) {\n  const barColor = value >= 75 ? '#34d399' : value >= 50 ? '#fbbf24' : '#f87171';\n  return (\n    <div className=\"w-full h-2 bg-white/10 rounded-full overflow-hidden mt-1\" role=\"progressbar\" aria-valuenow={value} aria-valuemin={0} aria-valuemax={100} aria-label={`Mastery: ${value}%`}>\n      <motion.div\n        className=\"h-full rounded-full\"\n        style={{ backgroundColor: barColor }}\n        initial={{ width: 0 }}\n        animate={{ width: `${value}%` }}\n        transition={{ duration: 0.8, ease: easeOut }}\n      />\n    </div>\n  );\n}\n\nfunction LanguageToggle({ lang, setLang }: { lang: string; setLang: (l: string) => void }) {\n  const opts = [\n    { code: 'en', label: 'EN', full: 'English' },\n    { code: 'hinglish', label: 'हिं', full: 'Hinglish' },\n    { code: 'hi', label: 'हि', full: 'हिन्दी' },\n  ];\n  return (\n    <div className=\"flex items-center gap-1 p-1 rounded-xl bg-white/10 backdrop-blur-md border border-white/10\" role=\"radiogroup\" aria-label={t('language', lang)}>\n      {opts.map((opt) => (\n        <button\n          key={opt.code}\n          onClick={() => setLang(opt.code)}\n          role=\"radio\"\n          aria-checked={lang === opt.code}\n          aria-label={opt.full}\n          className={\`px-3 py-1.5 rounded-lg text-sm font-medium transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-pink-400/60 \\\n            ${lang === opt.code\n              ? 'bg-gradient-to-r from-indigo-500 to-pink-500 text-white shadow-lg shadow-indigo-500/25'\n              : 'text-white/60 hover:text-white hover:bg-white/10'\n            }\`}\n        >\n          {opt.label}\n        </button>\n      ))}\n    </div>\n  );\n}\n\nfunction StatCard({ icon, label, value, sub, color, delay }: { icon: string; label: string; value: string | number; sub?: string; color: string; delay: number }) {\n  return (\n    <motion.div\n      initial={{ opacity: 0, y: 20 }}\n      animate={{ opacity: 1, y: 0 }}\n      transition={{ delay, ...spring }}\n      className=\"relative overflow-hidden rounded-2xl p-5 border border-white/10 backdrop-blur-xl\"\n      style={{ background: `linear-gradient(135deg, ${color}22, ${color}08)` }}\n    >\n      <div className=\"absolute top-0 right-0 w-24 h-24 rounded-full blur-2xl opacity-30\" style={{ backgroundColor: color }} />\n      <div className=\"relative\">\n        <div className=\"text-2xl mb-1\">{icon}</div>\n        <p className=\"text-white/50 text-xs font-medium uppercase tracking-wider mb-1\">{label}</p>\n        <p className=\"text-3xl font-bold text-white tracking-tight\">{value}</p>\n        {sub && <p className=\"text-white/40 text-xs mt-1\">{sub}</p>}\n      </div>\n    </motion.div>\n  );\n}\n\nfunction ClassCard({ cls, onSelect, lang, index }: { cls: ClassData; onSelect: () => void; lang: string; index: number }) {\n  const strugglingCount = cls.students.filter(s => s.mastery < 40).length;\n  return (\n    <motion.button\n      initial={{ opacity: 0, y: 30 }}\n      animate={{ opacity: 1, y: 0 }}\n      transition={{ delay: index * 0.08, ...spring }}\n      whileHover={{ y: -4, scale: 1.01 }}\n      whileTap={{ scale: 0.98 }}\n      onClick={onSelect}\n      className=\"w-full text-left relative overflow-hidden rounded-2xl p-5 border border-white/10 backdrop-blur-xl cursor-pointer group\"\n      style={{ background: 'linear-gradient(145deg, rgba(99,102,241,0.15), rgba(236,72,153,0.08))' }}\n    >\n      <div className=\"absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300\" style={{ background: 'linear-gradient(135deg, rgba(99,102,241,0.2), rgba(236,72,153,0.15))' }} />\n      <div className=\"relative\">\n        <div className=\"flex items-start justify-between mb-3\">\n          <div>\n            <h3 className=\"text-white font-bold text-lg leading-tight\">{cls.name}</h3>\n            <p className=\"text-indigo-300/70 text-sm mt-0.5\">{cls.subject}</p>\n          </div>\n          <span className=\"text-xs bg-white/10 text-white/60 px-2 py-1 rounded-lg font-medium\">\n            {t('students', lang)}: {cls.studentCount}\n          </span>\n        </div>\n        <div className=\"flex items-center gap-4\">\n          <div className=\"flex-1\">\n            <p className=\"text-white/40 text-xs mb-1\">{t('avgMastery', lang)}</p>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"text-white font-bold text-sm\">{cls.averageMastery}%</span>\n              <MasteryBar value={cls.averageMastery} />\n            </div>\n          </div>\n          <div className=\"w-px h-10 bg-white/10\" />\n          <div className=\"flex-1\">\n            <p className=\"text-white/40 text-xs mb-1\">{t('completionRate', lang)}</p>\n            <span className=\"text-white font-bold text-sm\">{cls.homeworkCompletionRate}%</span>\n          </div>\n          {strugglingCount > 0 && (\n            <div className=\"w-px h-10 bg-white/10\" />\n            <div>\n              <p className=\"text-red-400/60 text-xs mb-1\">{t('struggling', lang)}</p>\n              <span className=\"text-red-400 font-bold text-sm\">{strugglingCount}</span>\n            </div>\n          )}\n        </div>\n      </div>\n    </motion.button>\n  );\n}\n\nfunction StudentTable({ students, onRemediate, lang }: { students: Student[]; onRemediate: (id: string) => void; lang: string }) {\n  const struggling = students.filter(s => s.mastery < 40);\n  const others = students.filter(s => s.mastery >= 40);\n  const sorted = [...struggling, ...others];\n\n  return (\n    <div className=\"space-y-3\">\n      {sorted.map((student, i) => {\n        const isStruggling = student.mastery < 40;\n        return (\n          <motion.div\n            key={student.id}\n            initial={{ opacity: 0, x: -20 }}\n            animate={{ opacity: 1, x: 0 }}\n            transition={{ delay: i * 0.04, ...spring }}\n            className={`relative rounded-xl p-4 border backdrop-blur-md ${\n              isStruggling\n                ? 'border-red-500/40 bg-red-500/10 shadow-lg shadow-red-500/10'\n                : 'border-white/10 bg-white/5'\n            }`}\n          >\n            {isStruggling && (\n              <div className=\"absolute top-0 left-0 w-1.5 h-full rounded-l-xl bg-red-500\" />\n            )}\n            <div className=\"flex items-start justify-between gap-3\">\n              <div className=\"flex-1 min-w-0\">\n                <div className=\"flex items-center gap-2 mb-1\">\n                  <div className={\`w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-white ${\n                    isStruggling ? 'bg-red-500/30 text-red-300' : 'bg-indigo-500/30 text-indigo-300'\n                  }`}>\n                    {student.name.charAt(0)}\n                  </div>\n                  <span className=\"text-white font-semibold text-sm truncate\">{student.name}</span>\n                  {isStruggling && (\n                    <span className=\"shrink-0 text-xs bg-red-500/20 text-red-300 px-2 py-0.5 rounded-full font-medium border border-red-500/30\">\n                      ⚠ {t('struggling', lang)}\n                    </span>\n                  )}\n                </div>\n                <div className=\"flex items-center gap-3 ml-10\">\n                  <div className=\"flex-1 max-w-[200px]\">\n                    <MasteryBar value={student.mastery} />\n                  </div>\n                  <span className={\`text-xs font-bold min-w-[36px] text-right ${isStruggling ? 'text-red-300' : 'text-white/60'}\`}>\n                    {student.mastery}%\n                  </span>\n                </div>\n                <div className=\"ml-10 mt-2 flex items-center gap-3 flex-wrap\">\n                  <span className={`text-xs px-2 py-0.5 rounded-full border ${\n                    student.completedHomework\n                      ? 'text-emerald-300 bg-emerald-400/10 border-emerald-400/20'\n                      : 'text-red-300 bg-red-400/10 border-red-400/20'\n                  }`}>\n                    {student.completedHomework ? '✅' : '❌'} {t('homeworkStatus', lang)}\n                  </span>\n                  {student.topicsStruggling.length > 0 && (\n                    <span className=\"text-xs text-red-300/70\">\n                      {student.topicsStruggling.join(', ')}\n                    </span>\n                  )}\n                </div>\n              </div>\n              {isStruggling && (\n                <motion.button\n                  whileHover={{ scale: 1.05 }}\n                  whileTap={{ scale: 0.95 }}\n                  onClick={() => onRemediate(student.id)}\n                  className=\"shrink-0 px-3 py-2 rounded-xl bg-red-500/20 hover:bg-red-500/30 border border-red-500/30 text-red-300 text-xs font-semibold transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-red-400/60\"\n                  aria-label={\"Send remediation to \" + student.name}\n                >\n                  {t('remediation', lang)}\n                </motion.button>\n              )}\n            </div>\n          </motion.div>\n        );\n      })}\n    </div>\n  );\n}\n\nfunction WorksheetForm({ form, setForm, onGenerate, onPreview, lang, isGenerating }: {\n  form: WorksheetForm;\n  setForm: (f: WorksheetForm) => void;\n  onGenerate: () => void;\n  onPreview: () => void;\n  lang: string;\n  isGenerating: boolean;\n}) {\n  const topics = topicOptions[form.subject] || [];\n  const [ratioError, setRatioError] = useState<string | null>(null);\n\n  const updateRatio = (key: string, val: number) => {\n    const newRatios = { ...form.competencyRatios, [key]: val };\n    const total = Object.values(newRatios).reduce((a, b) => a + b, 0);\n    if (total > 100) {\n      setRatioError(`Total exceeds 100% (currently ${total}%)`);\n      return;\n    }\n    setRatioError(null);\n    setForm({ ...form, competencyRatios: newRatios });\n  };\n\n  const ratios = {\n    memory: form.competencyRatios.memory || 20,\n    understanding: form.competencyRatios.understanding || 30,\n    application: form.competencyRatios.application || 50,\n  };\n  const totalRatio = ratios.memory + ratios.understanding + ratios.application;\n\n  return (\n    <div className=\"space-y-5\">\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n        <div>\n          <label className=\"block text-white/60 text-xs font-medium mb-2\" htmlFor=\"subject\">\n            {t('subject', lang)}\n          </label>\n          <select\n            id=\"subject\"\n            value={form.subject}\n            onChange={(e) => setForm({ ...form, subject: e.target.value, topic: '' })}\n            className=\"w-full px-4 py-3 rounded-xl bg-white/10 border border-white/15 text-white text-sm backdrop-blur-md focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400/60 transition-all\"\n            aria-label={t('subject', lang)}\n          >\n            {subjectOptions.map((s) => (\n              <option key={s} value={s} className=\"bg-gray-900\">{s}</option>\n            ))}\n          </select>\n        </div>\n        <div>\n          <label className=\"block text-white/60 text-xs font-medium mb-2\" htmlFor=\"topic\">\n            {t('topic', lang)}\n          </label>\n          <select\n            id=\"topic\"\n            value={form.topic}\n            onChange={(e) => setForm({ ...form, topic: e.target.value })}\n            className=\"w-full px-4 py-3 rounded-xl bg-white/10 border border-white/15 text-white text-sm backdrop-blur-md focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400/60 transition-all disabled:opacity-40\"\n            disabled={!form.subject}\n            aria-label={t('topic', lang)}\n          >\n            <option value=\"\" className=\"bg-gray-900\">Select topic...</option>\n            {topics.map((tp) => (\n              <option key={tp} value={tp} className=\"bg-gray-900\">{tp}</option>\n            ))}\n          </select>\n        </div>\n      </div>\n\n      <div>\n        <label className=\"block text-white/60 text-xs font-medium mb-3\">\n          {t('difficulty', lang)}: <span className=\"text-white font-bold\">{t(form.difficulty, lang)}</span>\n        </label>\n        <div className=\"flex gap-2\" role=\"radiogroup\" aria-label={t('difficulty', lang)}>\n          {(['easy', 'medium', 'hard', 'mixed'] as const).map((d) => (\n            <button\n              key={d}\n              role=\"radio\"\n              aria-checked={form.difficulty === d}\n              onClick={() => setForm({ ...form, difficulty: d })}\n              className={\`flex-1 py-2.5 rounded-xl text-sm font-medium transition-all border focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400/60 ${\n                form.difficulty === d\n                  ? 'bg-gradient-to-r from-indigo-500/30 to-pink-500/30 border-indigo-400/40 text-white shadow-lg'\n                  : 'bg-white/5 border-white/10 text-white/50 hover:text-white/70'\n              }\`}\n            >\n              {t(d, lang)}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      <div>\n        <label className=\"block text-white/60 text-xs font-medium mb-2\">\n          {t('numQuestions', lang)}: <span className=\"text-white font-bold\">{form.numQuestions}</span>\n        </label>\n        <input\n          type=\"range\"\n          min={3}\n          max={20}\n          value={form.numQuestions}\n          onChange={(e) => setForm({ ...form, numQuestions: Number(e.target.value) })}\n          className=\"w-full accent-indigo-500 h-2 bg-white/10 rounded-full appearance-none cursor-pointer\"\n          aria-label={\"Number of questions: \" + form.numQuestions}\n        />\n        <div className=\"flex justify-between text-white/30 text-xs mt-1\">\n          <span>3</span>\n          <span>20</span>\n        </div>\n      </div>\n\n      <div>\n        <p className=\"text-white/60 text-xs font-medium mb-3\">{t('competencies', lang)}</p>\n        <div className=\"space-y-3\">\n          {(['memory', 'understanding', 'application'] as const).map((key) => (\n            <div key={key}>\n              <div className=\"flex items-center justify-between mb-1\">\n                <span className=\"text-white/70 text-sm\">{t(key, lang)}</span>\n                <span className=\"text-white text-sm font-bold\">{ratios[key]}%</span>\n              </div>\n              <input\n                type=\"range\"\n                min={0}\n                max={100}\n                step={5}\n                value={ratios[key]}\n                onChange={(e) => updateRatio(key, Number(e.target.value))}\n                className=\"w-full h-1.5 bg-white/10 rounded-full appearance-none cursor-pointer\"\n                style={{ accentColor: key === 'memory' ? '#818cf8' : key === 'understanding' ? '#f472b6' : '#34d399' }}\n                aria-label={`${t(key, lang)}: ${ratios[key]}%`}\n              />\n            </div>\n          ))}\n        </div>\n        <div className=\"mt-2 flex items-center justify-between\">\n          <span className=\"text-xs text-white/40\">Total: {totalRatio}%</span>\n          {ratioError && <span className=\"text-xs text-red-400 font-medium\">{ratioError}</span>}\n          {totalRatio === 100 && !ratioError && (\n            <span className=\"text-xs text-emerald-400 font-medium\">✅ Balanced</span>\n          )}\n        </div>\n      </div>\n\n      <div className=\"flex gap-3 pt-2\">\n        <motion.button\n          whileHover={{ scale: 1.02 }}\n          whileTap={{ scale: 0.98 }}\n          onClick={onPreview}\n          disabled={!form.topic}\n          className=\"flex-1 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 border border-white/15 text-white font-semibold text-sm transition-all disabled:opacity-40 disabled:cursor-not-allowed focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400/60\"\n        >\n          👁 {t('preview', lang)}\n        </motion.button>\n        <motion.button\n          whileHover={{ scale: 1.02 }}\n          whileTap={{ scale: 0.98 }}\n          onClick={onGenerate}\n          disabled={!form.topic || isGenerating || !!ratioError}\n          className=\"flex-1 py-3.5 rounded-xl bg-gradient-to-r from-indigo-500 to-pink-500 hover:from-indigo-600 hover:to-pink-600 text-white font-bold text-sm shadow-lg shadow-indigo-500/25 transition-all disabled:opacity-40 disabled:cursor-not-allowed focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400/60\"\n        >\n          {isGenerating ? '⏳ Generating...' : '✨ ' + t('generateWorksheet', lang)}\n        </motion.button>\n      </div>\n    </div>\n  );\n}\n\nfunction QuestionPreview({ questions, onConfirm, onBack, lang }: {\n  questions: WorksheetQuestion[];\n  onConfirm: () => void;\n  onBack: () => void;\n  lang: string;\n}) {\n  const difficultyColors = {\n    easy: 'bg-emerald-400/15 text-emerald-300 border-emerald-400/25',\n    medium: 'bg-amber-400/15 text-amber-300 border-amber-400/25',\n    hard: 'bg-red-400/15 text-red-300 border-red-400/25',\n  };\n  const competencyColors = {\n    memory: 'border-indigo-400/25 bg-indigo-400/10 text-indigo-300',\n    understanding: 'border-pink-400/25 bg-pink-400/10 text-pink-300',\n    application: 'border-emerald-400/25 bg-emerald-400/10 text-emerald-300',\n  };\n\n  return (\n    <motion.div\n      initial={{ opacity: 0, x: 40 }}\n      animate={{ opacity: 1, x: 0 }}\n      transition={spring}\n      className=\"space-y-4\"\n    >\n      <div className=\"flex items-center justify-between\">\n        <h3 className=\"text-white font-bold text-lg\">📋 {t('worksheetPreview', lang)}</h3>\n        <button\n          onClick={onBack}\\n          className=\"text-white/50 hover:text-white text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40 rounded-lg px-3 py-1\"\n        >\n          ← {t('back', lang)}\n        </button>\n      </div>\n\n      <div className=\"space-y-3\">\n        {questions.map((q, i) => (\n          <motion.div\n            key={q.id}\n            initial={{ opacity: 0, y: 10 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ delay: i * 0.05, ...spring }}\n            className=\"rounded-xl p-4 border border-white/10 bg-white/5 backdrop-blur-md\"\n          >\n            <div className=\"flex items-start gap-3\">\n              <span className=\"text-white/30 font-bold text-sm mt-0.5 shrink-0\">{i + 1}.</span>\n              <div className=\"flex-1 min-w-0\">\n                <p className=\"text-white text-sm leading-relaxed\">{q.text}</p>\n                <div className=\"flex items-center gap-2 mt-2\">\n                  <span className={`text-xs px-2 py-0.5 rounded-full border font-medium ${difficultyColors[q.difficulty]}`}>\n                    {t(q.difficulty, lang)}\n                  </span>\n                  <span className={`text-xs px-2 py-0.5 rounded-full border font-medium ${competencyColors[q.competency]}`}>\n                    {t(q.competency, lang)}\n                  </span>\n                </div>\n              </div>\n            </div>\n          </motion.div>\n        ))}\n      </div>\n\n      <div className=\"flex gap-3 pt-2\">\n        <motion.button\n          whileHover={{ scale: 1.02 }}\n          whileTap={{ scale: 0.98 }}\n          onClick={onBack}\n          className=\"flex-1 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 border border-white/15 text-white font-semibold text-sm transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400/60\"\n        >\n          ← {t('back', lang)}\n        </motion.button>\n        <motion.button\n          whileHover={{ scale: 1.02 }}\n          whileTap={{ scale: 0.98 }}\n          onClick={onConfirm}\n          className=\"flex-1 py-3.5 rounded-xl bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 text-white font-bold text-sm shadow-lg shadow-green-500/25 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-green-400/60\"\n        >\n          📱 {t('sendWhatsApp', lang)} ({questions.length})\n        </motion.button>\n      </div>\n    </motion.div>\n  );\n}\n\n// --- PAGE ---\nexport default function TeacherDashboard() {\n  const [lang, setLang] = useState('en');\n  const [selectedClass, setSelectedClass] = useState<ClassData | null>(null);\n  const [activeTab, setActiveTab] = useState<'overview' | 'worksheet' | 'performance'>('overview');\n  const [subTab, setSubTab] = useState<'form' | 'preview'>('form');\n  const [worksheetForm, setWorksheetForm] = useState<WorksheetForm>({\n    subject: 'Mathematics',\n    topic: '',\n    difficulty: 'mixed',\n    numQuestions: 5,\n    competencyRatios: { memory: 20, understanding: 30, application: 50 },\n  });\n  const [generatedQuestions, setGeneratedQuestions] = useState<WorksheetQuestion[]>([]);\n  const [isGenerating, setIsGenerating] = useState(false);\n  const [sentFlash, setSentFlash] = useState(false);\n  const [searchQuery, setSearchQuery] = useState('');\n\n  const handleGenerate = useCallback(() => {\n    setIsGenerating(true);\n    setTimeout(() => {\n      const shuffled = [...sampleQuestions].sort(() => Math.random() - 0.5);\n      const count = Math.min(worksheetForm.numQuestions, shuffled.length);\n      setGeneratedQuestions(shuffled.slice(0, count));\n      setIsGenerating(false);\n      setSubTab('preview');\n    }, 1200);\n  }, [worksheetForm.numQuestions]);\n\n  const handleSendWhatsApp = useCallback(() => {\n    setSentFlash(true);\n    setTimeout(() => setSentFlash(false), 3000);\n  }, []);\n\n  const handleRemediate = useCallback((studentId: string) => {\n    alert(`📱 Opening WhatsApp to send remediation content... (student ID: ${studentId})`);\n  }, []);\n\n  const filteredStudents = useMemo(() => {\n    if (!selectedClass || !searchQuery.trim()) return selectedClass?.students || [];\n    const q = searchQuery.toLowerCase();\n    return selectedClass.students.filter(s => s.name.toLowerCase().includes(q) || s.topicsStruggling.some(t => t.toLowerCase().includes(q)));\n  }, [selectedClass, searchQuery]);\n\n  // --- CLASS SELECTION VIEW ---\n  if (!selectedClass) {\n    return (\n      <div className=\"min-h-screen bg-gradient-to-br from-gray-950 via-indigo-950/30 to-gray-950\" role=\"main\">\n        <div className=\"max-w-lg mx-auto px-4 py-8\">\n          <header className=\"flex items-center justify-between mb-8\">\n            <div>\n              <motion.h1\n                initial={{ opacity: 0, y: -20 }}\n                animate={{ opacity: 1, y: 0 }}\n                className=\"text-2xl font-bold text-white\"\n              >\n                👩‍🏫 {t('dashboardTitle', lang)}\n              </motion.h1>\n              <motion.p\n                initial={{ opacity: 0 }}\n                animate={{ opacity: 1 }}\n                transition={{ delay: 0.2 }}\n                className=\"text-white/40 text-sm mt-1\"\n              >\n                Mrs. Sharma\n              </motion.p>\n            </div>\n            <LanguageToggle lang={lang} setLang={setLang} />\n          </header>\n\n          <motion.p\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            transition={{ delay: 0.15 }}\n            className=\"text-white/50 text-sm mb-4\"\n          >\n            {t('classes', lang)}\n          </motion.p>\n\n          <div className=\"space-y-4\">\n            {mockClasses.map((cls, i) => (\n              <ClassCard\n                key={cls.id}\n                cls={cls}\n                lang={lang}\n                index={i}\n                onSelect={() => setSelectedClass(cls)}\n              />\n            ))}\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  // --- CLASS DETAIL VIEW ---\n  const cls = selectedClass;\n  const strugglingCount = cls.students.filter(s => s.mastery < 40).length;\n  const tabs = [\n    { key: 'overview' as const, label: t('classes', lang), icon: '📊' },\n    { key: 'worksheet' as const, label: t('createWorksheet', lang), icon: '📝' },\n    { key: 'performance' as const, label: t('performance', lang), icon: '📈' },\n  ];\n\n  return (\n    <div className=\"min-h-screen bg-gradient-to-br from-gray-950 via-indigo-950/30 to-gray-950\" role=\"main\">\n      <div className=\"max-w-2xl mx-auto px-4 py-6\">\n        {/* Header */}\n        <header className=\"flex items-center justify-between mb-6\">\n          <div className=\"flex items-center gap-3\">\n            <motion.button\n              whileHover={{ scale: 1.1 }}\n              whileTap={{ scale: 0.9 }}\n              onClick={() => { setSelectedClass(null); setActiveTab('overview'); setSubTab('form'); setGeneratedQuestions([]); }}\n              className=\"w-9 h-9 rounded-xl bg-white/10 hover:bg-white/15 border border-white/10 flex items-center justify-center text-white/70 hover:text-white transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40\"\n              aria-label=\"Back to classes\"\n            >\n              ←\n            </motion.button>\n            <div>\n              <motion.h1 className=\"text-xl font-bold text-white leading-tight\" layout>\n                {cls.name}\n              </motion.h1>\n              <motion.p className=\"text-white/40 text-xs\" layout>{cls.subject} · {cls.studentCount} {t('students', lang)}</motion.p>\n            </div>\n          </div>\n          <LanguageToggle lang={lang} setLang={setLang} />\n        </header>\n\n        {/* Tab Switcher */}\n        <div className=\"flex p-1 rounded-xl bg-white/5 border border-white/10 mb-6\" role=\"tablist\" aria-label=\"Dashboard sections\">\n          {tabs.map((tab) => (\n            <button\n              key={tab.key}\n              role=\"tab\"\n              aria-selected={activeTab === tab.key}\n              onClick={() => { setActiveTab(tab.key); if (tab.key !== 'worksheet') setSubTab('form'); }}\n              className={\`flex-1 py-2.5 rounded-lg text-xs font-semibold transition-all flex items-center justify-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400/60 ${\n                activeTab === tab.key\n                  ? 'bg-gradient-to-r from-indigo-500/30 to-pink-500/30 text-white shadow-md'\n                  : 'text-white/40 hover:text-white/60'\n              }\`}\n            >\n              <span>{tab.icon}</span>\n              <span className=\"hidden sm:inline\">{tab.label}</span>\n            </button>\n          ))}\n        </div>\n\n        {/* Tab Content */}\n        <AnimatePresence mode=\"wait\">\n          {activeTab === 'overview' && (\n            <motion.div\n              key=\"overview\"\n              initial={{ opacity: 0, y: 15 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -15 }}\n              transition={{ duration: 0.25, ease: easeOut }}\n              className=\"space-y-5\"\n            >\n              <div className=\"grid grid-cols-3 gap-3\">\n                <StatCard\n                  icon=\"👥\"\n                  label={t('students', lang)}\n                  value={cls.studentCount}\n                  color=\"#6366f1\"\n                  delay={0}\n                />\n                <StatCard\n                  icon=\"🎯\"\n                  label={t('avgMastery', lang)}\n                  value={`${cls.averageMastery}%`}\n                  color=\"#f472b6\"\n                  delay={0.1}\n                />\n                <StatCard\n                  icon=\"📋\"\n                  label={t('completionRate', lang)}\n                  value={`${cls.homeworkCompletionRate}%`}\n                  color=\"#34d399\"\n                  delay={0.2}\n                />\n              </div>\n\n              {strugglingCount > 0 && (\n                <motion.div\n                  initial={{ opacity: 0, scale: 0.95 }}\n                  animate={{ opacity: 1, scale: 1 }}\n                  className=\"rounded-2xl p-5 border border-red-500/30 bg-red-500/10 backdrop-blur-xl\"\n                >\n                  <div className=\"flex items-center gap-2 mb-2\">\n                    <span className=\"text-xl\">⚠️</span>\n                    <h3 className=\"text-red-300 font-bold text-sm\">\n                      {strugglingCount} {t('struggling', lang)} {t('students', lang).toLowerCase()}\n                    </h3>\n                  </div>\n                  <p className=\"text-red-300/60 text-xs\">\n                    Mastery below 40%. Tap Performance tab for details and remediation.\n                  </p>\n                </motion.div>\n              )}\n\n              <div>\n                <h3 className=\"text-white/50 text-xs font-medium uppercase tracking-wider mb-3\">Quick Actions</h3>\n                <div className=\"grid grid-cols-2 gap-3\">\n                  {[\n                    { icon: '📝', label: t('createWorksheet', lang), action: () => setActiveTab('worksheet') },\n                    { icon: '📈', label: t('performance', lang), action: () => setActiveTab('performance') },\n                  ].map((action, i) => (\n                    <motion.button\n                      key={i}\n                      initial={{ opacity: 0, y: 10 }}\n                      animate={{ opacity: 1, y: 0 }n                      transition={{ delay: 0.3 + i * 0.08 }}\n                      whileHover={{ scale: 1.03 }}\n                      whileTap={{ scale: 0.97 }}\n                      onClick={action.action}\n                      className=\"rounded-xl p-4 border border-white/10 bg-white/5 hover:bg-white/10 backdrop-blur-md text-left transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400/60\"\n                    >\n                      <span className=\"text-2xl block mb-2\">{action.icon}</span>\n                      <span className=\"text-white text-sm font-semibold\">{action.label}</span>\n                    </motion.button>\n                  ))}\n                </div>\n              </div>\n            </motion.div>\n          )}\n\n          {activeTab === 'worksheet' && (\n            <motion.div\n              key=\"worksheet\"\n              initial={{ opacity: 0, y: 15 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -15 }}\n              transition={{ duration: 0.25, ease: easeOut }}\n            >\n              <AnimatePresence mode=\"wait\">\n                {subTab === 'form' && (\n                  <motion.div key=\"form\" initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}>\n                    <WorksheetForm\n                      form={worksheetForm}\n                      setForm={setWorksheetForm}\n                      onGenerate={handleGenerate}\n                      onPreview={() => setSubTab('preview')}\n                      lang={lang}\n                      isGenerating={isGenerating}\n                    />\n                  </motion.div>\n                )}\n                {subTab === 'preview' && (\n                  <motion.div key=\"preview\" initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}>\n                    <QuestionPreview\n                      questions={generatedQuestions}\n                      onConfirm={handleSendWhatsApp}\n                      onBack={() => setSubTab('form')}\n                      lang={lang}\n                    />\n                  </motion.div>\n                )}\n              </AnimatePresence>\n            </motion.div>\n          )}\n\n          {activeTab === 'performance' && (\n            <motion.div\n              key=\"performance\"\n              initial={{ opacity: 0, y: 15 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -15 }}\n              transition={{ duration: 0.25, ease: easeOut }}\n              className=\"space-y-4\"\n            >\n              <div className=\"flex items-center justify-between\">\n                <h3 className=\"text-white font-bold text-lg\">{t('allStudents', lang)}</h3>\n                <span className=\"text-xs text-white/40 bg-white/5 px-3 py-1 rounded-full\">\n                  {filteredStudents.length} {t('students', lang)}\n                </span>\n              </div>\n\n              <div className=\"relative\">\n                <input\n                  type=\"search\"\n                  placeholder=\"Search students or topics...\"\n                  value={searchQuery}\n                  onChange={(e) => setSearchQuery(e.target.value)}\n                  className=\"w-full px-4 py-3 pl-10 rounded-xl bg-white/10 border border-white/15 text-white text-sm placeholder:text-white/30 backdrop-blur-md focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400/60 transition-all\"\n                  aria-label=\"Search students\"\n                />\n                <span className=\"absolute left-3 top-3.5 text-white/30\">🔍</span>\n              </div>\n\n              <StudentTable students={filteredStudents} onRemediate={handleRemediate} lang={lang} />\n            </motion.div>\n          )}\n        </AnimatePresence>\n\n        {/* WhatsApp Sent Flash */}\n        <AnimatePresence>\n          {sentFlash && (\n            <motion.div\n              initial={{ opacity: 0, y: 50, scale: 0.9 }}\n              animate={{ opacity: 1, y: 0, scale: 1 }}\n              exit={{ opacity: 0, y: 20, scale: 0.95 }}\n              className=\"fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-6 py-4 rounded-2xl bg-green-500 text-white shadow-2xl shadow-green-500/40 border border-green-400/30 flex items-center gap-3\"\n              role=\"alert\"\n            >\n              <span className=\"text-2xl\">✅</span>\n              <div>\n                <p className=\"font-bold text-sm\">{t('sent', lang)}</p>\n                <p className=\"text-green-100 text-xs\">Homework sent to {cls.studentCount} students via WhatsApp</p>\n              </div>\n            </motion.div>\n          )}\n        </AnimatePresence>\n      </div>\n    </div>\n  );\n}\n"
  }
}
```