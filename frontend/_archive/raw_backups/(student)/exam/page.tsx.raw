'use client';

import React, { useState, useEffect, useCallback, useMemo, useRef } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { katex } from 'katex';
import 'katex/dist/katex.min.css';

// ─── Types ────────────────────────────────────────────────────────────────────

type Language = 'en' | 'hinglish' | 'hindi';
type ExamPhase = 'select' | 'ready' | 'exam' | 'review' | 'results';
type TimerWarning = 'normal' | 'yellow' | 'red' | 'flashing';
type Section = 'A' | 'B';
type QType = 'mcq' | 'short' | 'long' | 'verylong';

interface Question {
  id: string;
  section: Section;
  number: number;
  type: QType;
  marks: number;
  topic: string;
  subTopic: string;
  text: string;
  latex?: string;
  options?: string[];
  correctAnswer: number | string;
  explanation: string;
  difficulty: 'easy' | 'medium' | 'hard';
  tags: string[];
  maxTimeSuggestion: number; // seconds
}

interface SectionConfig {
  id: Section;
  label: Record<Language, string>;
  description: Record<Language, string>;
  isCompulsory: boolean;
  questions: Question[];
}

interface SubjectConfig {
  id: string;
  name: Record<Language, string>;
  icon: string;
  totalMarks: number;
  durationMinutes: number;
  sections: SectionConfig[];
  passMarks: number;
}

interface AnswerState {
  questionId: string;
  answer: string | number | null;
  markedForReview: boolean;
  timeSpent: number; // seconds
  attemptCount: number;
}

interface TimeAnalysis {
  totalTime: number;
  avgTimePerMark: number;
  sectionTime: Record<Section, number>;
  topicTime: Record<string, number>;
  fastestQuestion: { q: string; time: number } | null;
  slowestQuestion: { q: string; time: number } | null;
}

interface TopicMastery {
  topic: string;
  totalMarks: number;
  earnedMarks: number;
  questions: number;
  correct: number;
  timeSpent: number;
  suggestedTime: number;
  efficiency: 'excellent' | 'good' | 'average' | 'needs-work';
}

interface ExamResult {
  totalEarned: number;
  totalMarks: number;
  percentage: number;
  sectionBreakdown: Record<Section, { earned: number; total: number }>;
  topicMastery: TopicMastery[];
  timeAnalysis: TimeAnalysis;
  correctCount: number;
  totalQuestions: number;
  strategyTips: Tip[];
  grade: string;
  passed: boolean;
}

interface Tip {
  icon: string;
  title: Record<Language, string>;
  description: Record<Language, string>;
  priority: 'high' | 'medium' | 'low';
}

