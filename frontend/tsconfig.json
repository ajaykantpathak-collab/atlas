{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "katex/contrib/auto-render": ["./types/katex-auto-render.d.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "components/simulations", "components/sim-primitives", "lib/sim-engine", "lib/game-engine", "app/_archive", "scripts",
    "components/sims_v2/generated", "components/sims_v2/class*/v3", "components/sims_v2/class*/v3w", "components/sims_v2/class*/*.ts"]
}
