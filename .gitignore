# ── Custody overrides (owner 2026-10-15): git holds everything needed to rebuild ──
# deploy/ infra (Dockerfiles, compose, nginx, requirements, k8s, scripts) tracked;
# only its duplicated source trees + runtime data stay ignored (git canonical = root)
!deploy/
deploy/backend/
deploy/frontend/
deploy/content/
deploy/cbse_data/
deploy/data/
deploy/_work/
deploy/organized/
deploy/parsed_output/
deploy/.chisel/
# corpus IS the product — master copies sit on the same disk, so git is the off-site copy
!content/enhanced_nodes_md/
!content/cisce_nodes_v2/
# runtime assets the app serves — not optional
!frontend/public/**/*.png
!frontend/public/**/*.jpg
!frontend/public/**/*.webp
!frontend/public/**/*.mp3
!frontend/public/**/*.wav
*keys*.txt
**/target/
assets/diagram_lab/*.zip
