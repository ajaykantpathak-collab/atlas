# ── Production environment — copy to .env.production and fill in ────────
# NEVER commit the filled file. All values below are REQUIRED unless noted.

# Required: long random string (openssl rand -hex 64). Backend refuses to
# start in production without it.
PLATFORM_JWT_SECRET=change-me-platform-jwt-secret

# Database passwords
POSTGRES_PASSWORD=change-me-postgres-password
NEO4J_PASSWORD=change-me-neo4j-password
CLICKHOUSE_PASSWORD=change-me-clickhouse-password

# Public URL the browser uses to reach the API (nginx :80 on your domain,
# e.g. https://app.yourschool.in — no trailing slash, no port if 80/443)
PUBLIC_API_URL=http://localhost

# Comma-separated origins allowed to call the API (same domain list)
CORS_ORIGINS=http://localhost

# ── LLM keys (solver/tutor lanes — optional but recommended) ──────────
GEMINI_API_KEY=change-me-gemini-api-key
DEEPSEEK_API_KEY=change-me-deepseek-api-key

# ── Optional ops ───────────────────────────────────────────────────────
UVICORN_WORKERS=4
SENTRY_DSN=change-me-sentry-dsn
LOG_FORMAT=text
SOLVER_POOL_SIZE=8
SOLVER_TIMEOUT_S=12
FREE_TEXT_TIMEOUT_S=10
IDENTIFY_TIMEOUT_S=15

# Solver policy: off | parse_only | explain_only | fallback
# Production recommendation: off. The deterministic endpoint never calls an LLM.
SOLVER_LLM_MODE=off

# ── Host mount contract (2026-10-02 audit: D:-baked paths) ──────────
# These Windows host paths make the stack single-workstation. Override on
# any other host (Linux CI/second operator) by setting them here, e.g.:
#   CISCE_CORPUS_HOST=/data/cisce
#   CISCE_STEM_HOST=/data/cisce_stem
#   RUNTIME_DATA_HOST=/data/platform_runtime
CISCE_CORPUS_HOST=D:/cisce
CISCE_STEM_HOST=D:/_KEEP/atomic_graph/cisce_stem
RUNTIME_DATA_HOST=D:/platform/runtime_data
